{
  "typeName": "AWS::NetworkSecurityManager::Deployment",
  "description": "Resource Type definition for AWS::NetworkSecurityManager::Deployment. Creates and manages a Network Security Manager deployment.",
  "definitions": {
    "AssociatedPolicy": {
      "type": "object",
      "properties": {
        "PolicyArn": {
          "type": "string",
          "description": "ARN of the associated policy."
        }
      },
      "required": [
        "PolicyArn"
      ],
      "additionalProperties": false
    },
    "AssociatedScope": {
      "type": "object",
      "properties": {
        "ScopeArn": {
          "type": "string",
          "description": "ARN of the associated scope."
        }
      },
      "required": [
        "ScopeArn"
      ],
      "additionalProperties": false
    },
    "DeploymentConfiguration": {
      "type": "object",
      "description": "Configuration settings for the deployment.",
      "properties": {
        "EnableCrossAccountVisibility": {
          "type": "boolean",
          "description": "Whether cross-account visibility is enabled for the deployment."
        }
      },
      "required": [
        "EnableCrossAccountVisibility"
      ],
      "additionalProperties": false
    },
    "Tag": {
      "description": "A key-value pair to associate with a resource.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "Key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "Value": {
          "type": "string",
          "minLength": 0,
          "maxLength": 256
        }
      },
      "required": [
        "Key",
        "Value"
      ]
    }
  },
  "properties": {
    "DeploymentId": {
      "description": "The unique identifier of the deployment.",
      "type": "string"
    },
    "DeploymentArn": {
      "description": "The ARN of the deployment.",
      "type": "string"
    },
    "DeploymentName": {
      "description": "The name of the deployment.",
      "type": "string"
    },
    "DeploymentDescription": {
      "description": "A description of the deployment.",
      "type": "string"
    },
    "Status": {
      "description": "The status of the deployment.",
      "type": "string",
      "enum": [
        "DRAFT",
        "ACTIVE",
        "DISABLED"
      ]
    },
    "DeploymentConfiguration": {
      "$ref": "#/definitions/DeploymentConfiguration"
    },
    "AssociatedPolicyList": {
      "description": "List of policies associated with this deployment.",
      "type": "array",
      "insertionOrder": false,
      "items": {
        "$ref": "#/definitions/AssociatedPolicy"
      }
    },
    "AssociatedScopeList": {
      "description": "List of scopes associated with this deployment.",
      "type": "array",
      "insertionOrder": false,
      "items": {
        "$ref": "#/definitions/AssociatedScope"
      }
    },
    "Version": {
      "description": "The version number.",
      "type": "string",
      "pattern": "^[1-9][0-9]*$",
      "minLength": 1,
      "maxLength": 10
    },
    "UpdatedAt": {
      "description": "An ISO 8601 timestamp indicating when the deployment was last modified.",
      "type": "string",
      "format": "date-time"
    },
    "Tags": {
      "description": "The tags associated with the deployment.",
      "type": "array",
      "uniqueItems": true,
      "insertionOrder": false,
      "items": {
        "$ref": "#/definitions/Tag"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "DeploymentName"
  ],
  "createOnlyProperties": [
    "/properties/DeploymentName"
  ],
  "readOnlyProperties": [
    "/properties/DeploymentId",
    "/properties/DeploymentArn",
    "/properties/Status",
    "/properties/Version",
    "/properties/UpdatedAt"
  ],
  "primaryIdentifier": [
    "/properties/DeploymentArn"
  ],
  "additionalIdentifiers": [
    [
      "/properties/DeploymentId"
    ]
  ],
  "tagging": {
    "taggable": true,
    "tagOnCreate": true,
    "tagUpdatable": true,
    "cloudFormationSystemTags": true,
    "tagProperty": "/properties/Tags",
    "permissions": [
      "network-security-manager:TagResource",
      "network-security-manager:UntagResource",
      "network-security-manager:ListTagsForResource"
    ]
  },
  "handlers": {
    "create": {
      "permissions": [
        "network-security-manager:CreateDeployment",
        "network-security-manager:GetDeployment",
        "network-security-manager:TagResource",
        "network-security-manager:ListTagsForResource"
      ]
    },
    "read": {
      "permissions": [
        "network-security-manager:GetDeployment",
        "network-security-manager:ListTagsForResource"
      ]
    },
    "update": {
      "permissions": [
        "network-security-manager:UpdateDeployment",
        "network-security-manager:GetDeployment",
        "network-security-manager:TagResource",
        "network-security-manager:UntagResource",
        "network-security-manager:ListTagsForResource"
      ]
    },
    "delete": {
      "permissions": [
        "network-security-manager:DeleteDeployment",
        "network-security-manager:GetDeployment",
        "network-security-manager:ListTagsForResource"
      ]
    },
    "list": {
      "permissions": [
        "network-security-manager:ListDeployments"
      ]
    }
  }
}
