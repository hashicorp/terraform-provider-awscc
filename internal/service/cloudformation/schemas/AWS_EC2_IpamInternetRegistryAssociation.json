{
  "typeName": "AWS::EC2::IpamInternetRegistryAssociation",
  "description": "An association between an IPAM and a Regional Internet Registry (RIR) for delegated Resource Public Key Infrastructure (RPKI) management. Use it to have IPAM create Route Origin Authorizations (ROAs) for IP address prefixes registered with the internet registry. The IPAM must be in the Advanced tier.",
  "properties": {
    "IpamInternetRegistryAssociationArn": {
      "type": "string",
      "description": "The Amazon Resource Name (ARN) of the internet registry association.",
      "minLength": 1,
      "maxLength": 1283
    },
    "IpamInternetRegistryAssociationId": {
      "type": "string",
      "description": "The ID of the internet registry association."
    },
    "OwnerId": {
      "type": "string",
      "description": "The ID of the Amazon Web Services account that owns the internet registry association."
    },
    "IpamId": {
      "type": "string",
      "description": "The ID of the IPAM to associate with the internet registry."
    },
    "IpamRegion": {
      "type": "string",
      "description": "The Amazon Web Services Region of the IPAM."
    },
    "Rir": {
      "type": "string",
      "description": "The Regional Internet Registry to associate with. The service returns these values in upper case, so the enum uses the round-tripping form.",
      "enum": [
        "RIPE",
        "APNIC",
        "ARIN",
        "LACNIC"
      ]
    },
    "OrganizationHandle": {
      "type": "string",
      "description": "The organization handle at the internet registry (for example, a RIPE NCC organization ID or ARIN Org ID)."
    },
    "Description": {
      "type": "string",
      "description": "A description for the internet registry association."
    },
    "State": {
      "type": "string",
      "description": "The state of the internet registry association.",
      "enum": [
        "pending-enable",
        "create-in-progress",
        "create-failed",
        "enable-in-progress",
        "enable-complete",
        "enable-failed",
        "delete-in-progress",
        "delete-complete",
        "delete-failed"
      ]
    },
    "ChildRequestXml": {
      "type": "string",
      "description": "The XML content for the child request to be submitted to the internet registry to complete the BPKI setup."
    },
    "Tags": {
      "type": "array",
      "description": "The tags assigned to the internet registry association.",
      "items": {
        "$ref": "#/definitions/Tag"
      },
      "insertionOrder": false,
      "uniqueItems": true
    }
  },
  "definitions": {
    "Tag": {
      "type": "object",
      "properties": {
        "Key": {
          "type": "string",
          "description": "The key of the tag.",
          "minLength": 1,
          "maxLength": 127
        },
        "Value": {
          "type": "string",
          "description": "The value of the tag.",
          "minLength": 0,
          "maxLength": 256
        }
      },
      "required": [
        "Key",
        "Value"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "IpamId",
    "Rir",
    "OrganizationHandle"
  ],
  "createOnlyProperties": [
    "/properties/IpamId",
    "/properties/Rir",
    "/properties/OrganizationHandle",
    "/properties/Description"
  ],
  "readOnlyProperties": [
    "/properties/IpamInternetRegistryAssociationArn",
    "/properties/IpamInternetRegistryAssociationId",
    "/properties/OwnerId",
    "/properties/IpamRegion",
    "/properties/State",
    "/properties/ChildRequestXml"
  ],
  "primaryIdentifier": [
    "/properties/IpamInternetRegistryAssociationArn"
  ],
  "additionalIdentifiers": [
    [
      "/properties/IpamInternetRegistryAssociationId"
    ]
  ],
  "additionalProperties": false,
  "replacementStrategy": "delete_then_create",
  "tagging": {
    "taggable": true,
    "tagOnCreate": false,
    "tagUpdatable": true,
    "cloudFormationSystemTags": true,
    "tagProperty": "/properties/Tags",
    "permissions": [
      "ec2:CreateTags",
      "ec2:DeleteTags",
      "ec2:DescribeIpamInternetRegistryAssociations"
    ]
  },
  "handlers": {
    "create": {
      "permissions": [
        "ec2:CreateIpamInternetRegistryAssociation",
        "ec2:DescribeIpamInternetRegistryAssociations",
        "ec2:CreateTags"
      ]
    },
    "read": {
      "permissions": [
        "ec2:DescribeIpamInternetRegistryAssociations"
      ]
    },
    "update": {
      "permissions": [
        "ec2:CreateTags",
        "ec2:DeleteTags",
        "ec2:DescribeIpamInternetRegistryAssociations"
      ]
    },
    "delete": {
      "permissions": [
        "ec2:DeleteIpamInternetRegistryAssociation",
        "ec2:DescribeIpamInternetRegistryAssociations",
        "ec2:DeleteTags"
      ]
    },
    "list": {
      "permissions": [
        "ec2:DescribeIpamInternetRegistryAssociations"
      ]
    }
  }
}
