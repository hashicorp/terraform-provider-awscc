{
  "typeName": "AWS::BcmPricingCalculator::WorkloadEstimate",
  "description": "Resource Type definition for AWS::BcmPricingCalculator::WorkloadEstimate",
  "sourceUrl": "https://github.com/aws-cloudformation/aws-cloudformation-resource-providers-bcm-pricing-calculator",
  "definitions": {
