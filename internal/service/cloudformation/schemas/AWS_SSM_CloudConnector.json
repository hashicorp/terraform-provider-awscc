{
  "typeName": "AWS::SSM::CloudConnector",
  "description": "Resource Type definition for AWS::SSM::CloudConnector. Enables AWS Systems Manager to manage resources in external cloud providers.",
  "sourceUrl": "https://github.com/aws-cloudformation/aws-cloudformation-resource-providers-ssm.git",
  "definitions": {
    "Tag": {
      "type": "object",
      "properties": {
        "Key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "Value": {
          "type": "string",
          "minLength": 0,
          "maxLength": 256
        }
      },
      "required": [
        "Key",
        "Value"
      ],
      "additionalProperties": false
    },
    "CloudConnectorConfiguration": {
      "type": "object",
      "description": "The configuration for the cloud connector. Currently supports Azure.",
      "properties": {
        "AzureConfiguration": {
          "$ref": "#/definitions/AzureConfiguration"
        }
      },
      "required": [
        "AzureConfiguration"
      ],
      "additionalProperties": false
    },
    "AzureConfiguration": {
      "type": "object",
      "description": "Configuration for connecting to Azure.",
      "properties": {
        "TenantId": {
          "type": "string",
          "description": "The Azure AD tenant ID. Cannot be changed after creation.",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "TenantDisplayName": {
          "type": "string",
          "description": "The display name of the Azure AD tenant.",
          "minLength": 0,
          "maxLength": 256,
          "pattern": "^([\\p{L}\\p{Z}\\p{N}\\p{P}\\p{M}]*)$"
        },
        "ApplicationId": {
          "type": "string",
          "description": "The Azure AD application ID.",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "ApplicationDisplayName": {
          "type": "string",
          "description": "The display name of the Azure AD application.",
          "minLength": 0,
          "maxLength": 256,
          "pattern": "^([\\p{L}\\p{Z}\\p{N}\\p{P}\\p{M}]*)$"
        },
        "Targets": {
          "$ref": "#/definitions/ConfigurationTargets"
        }
      },
      "required": [
        "TenantId",
        "ApplicationId"
      ],
      "additionalProperties": false
    },
    "ConfigurationTargets": {
      "type": "object",
      "description": "The targets for the cloud connector. If omitted, the entire tenant is targeted.",
      "properties": {
        "Subscriptions": {
          "type": "array",
          "description": "List of Azure subscriptions.",
          "items": {
            "$ref": "#/definitions/AzureSubscription"
          },
          "minItems": 1,
          "maxItems": 75,
          "insertionOrder": false
        }
      },
      "required": [
        "Subscriptions"
      ],
      "additionalProperties": false
    },
    "AzureSubscription": {
      "type": "object",
      "description": "An Azure subscription with its ID and optional display name.",
      "properties": {
        "Id": {
          "type": "string",
          "description": "The Azure subscription ID.",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
          "minLength": 1,
          "maxLength": 256
        },
        "DisplayName": {
          "type": "string",
          "description": "The display name of the Azure subscription.",
          "minLength": 0,
          "maxLength": 128,
          "pattern": "^([\\p{L}\\p{Z}\\p{N}\\p{P}\\p{M}]*)$"
        }
      },
      "required": [
        "Id"
      ],
      "additionalProperties": false
    }
  },
  "properties": {
    "CloudConnectorArn": {
      "type": "string",
      "description": "The ARN of the cloud connector.",
      "pattern": "^arn:aws(-cn|-us-gov)?:ssm:[a-z0-9-]+:\\d{12}:cloud-connector/[a-f0-9-]+$"
    },
    "CloudConnectorId": {
      "type": "string",
      "description": "The unique identifier of the cloud connector.",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "DisplayName": {
      "type": "string",
      "description": "The display name of the cloud connector.",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[\\p{L}\\p{Z}\\p{N}\\p{P}\\p{M}]*$"
    },
    "Description": {
      "type": "string",
      "description": "The description of the cloud connector.",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^[\\p{L}\\p{Z}\\p{N}\\p{P}\\p{M}]*$"
    },
    "RoleArn": {
      "type": "string",
      "description": "The IAM role ARN used by the cloud connector.",
      "minLength": 20,
      "maxLength": 2048,
      "pattern": ""
    },
    "Configuration": {
      "$ref": "#/definitions/CloudConnectorConfiguration",
      "description": "The configuration for the cloud connector."
    },
    "ConfigConnectorArn": {
      "type": "string",
      "description": "The ARN of the AWS Config connector.",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^arn:aws(-cn|-us-gov)?:config:[a-z0-9-]+:\\d{12}:connector/.+$"
    },
    "Tags": {
      "type": "array",
      "description": "Tags to apply to the cloud connector.",
      "items": {
        "$ref": "#/definitions/Tag"
      },
      "maxItems": 50,
      "insertionOrder": false
    },
    "CreatedAt": {
      "type": "string",
      "description": "The timestamp when the cloud connector was created.",
      "format": "date-time"
    },
    "UpdatedAt": {
      "type": "string",
      "description": "The timestamp when the cloud connector was last updated.",
      "format": "date-time"
    }
  },
  "required": [
    "DisplayName",
    "RoleArn",
    "Configuration",
    "ConfigConnectorArn"
  ],
  "primaryIdentifier": [
    "/properties/CloudConnectorArn"
  ],
  "additionalIdentifiers": [
    [
      "/properties/CloudConnectorId"
    ]
  ],
  "readOnlyProperties": [
    "/properties/CloudConnectorArn",
    "/properties/CloudConnectorId",
    "/properties/CreatedAt",
    "/properties/UpdatedAt"
  ],
  "createOnlyProperties": [
    "/properties/RoleArn",
    "/properties/ConfigConnectorArn",
    "/properties/Configuration/AzureConfiguration/TenantId"
  ],
  "additionalProperties": false,
  "tagging": {
    "taggable": true,
    "tagOnCreate": true,
    "tagUpdatable": true,
    "cloudFormationSystemTags": true,
    "tagProperty": "/properties/Tags",
    "permissions": [
      "ssm:AddTagsToResource",
      "ssm:ListTagsForResource",
      "ssm:RemoveTagsFromResource"
    ]
  },
  "handlers": {
    "create": {
      "permissions": [
        "ssm:CreateCloudConnector",
        "ssm:GetCloudConnector",
        "ssm:AddTagsToResource",
        "ssm:ListTagsForResource",
        "iam:PassRole",
        "config:PutThirdPartyServiceLinkedConfigurationRecorder",
        "config:GetConnector"
      ]
    },
    "read": {
      "permissions": [
        "ssm:GetCloudConnector",
        "ssm:ListTagsForResource"
      ]
    },
    "update": {
      "permissions": [
        "ssm:UpdateCloudConnector",
        "ssm:GetCloudConnector",
        "ssm:AddTagsToResource",
        "ssm:RemoveTagsFromResource",
        "ssm:ListTagsForResource",
        "config:PutThirdPartyServiceLinkedConfigurationRecorder",
        "config:GetConnector"
      ]
    },
    "delete": {
      "permissions": [
        "ssm:DeleteCloudConnector",
        "ssm:GetCloudConnector",
        "ssm:ListAssociations",
        "config:PutThirdPartyServiceLinkedConfigurationRecorder",
        "config:DeleteServiceLinkedConfigurationRecorder",
        "config:GetConnector"
      ]
    },
    "list": {
      "permissions": [
        "ssm:ListCloudConnectors"
      ]
    }
  }
}
