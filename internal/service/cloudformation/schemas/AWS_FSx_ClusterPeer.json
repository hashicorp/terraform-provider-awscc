{
  "typeName": "AWS::FSx::ClusterPeer",
  "description": "Creates an Amazon FSx for NetApp ONTAP cluster peer relationship from a file system to another ONTAP cluster. Cluster peering lets the file system replicate data to and from the peer cluster with SnapMirror. Create a cluster peer on each side, with the same passphrase, to complete the relationship.",
  "definitions": {
    "AuthenticationStatus": {
      "type": "object",
      "description": "The authentication status of the cluster peer relationship in ONTAP.",
      "additionalProperties": false,
      "properties": {
        "State": {
          "type": "string",
          "description": "The authentication state, for example ok.",
          "minLength": 1,
          "maxLength": 64
        },
        "InUse": {
          "type": "string",
          "description": "The authentication method in use, for example ok.",
          "minLength": 1,
          "maxLength": 64
        }
      }
    },
    "Tag": {
      "type": "object",
      "description": "A key-value pair used to tag the cluster peer relationship.",
      "additionalProperties": false,
      "properties": {
        "Key": {
          "type": "string",
          "description": "The tag key.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^([\\p{L}\\p{Z}\\p{N}_.:/=+\\-@]*)$"
        },
        "Value": {
          "type": "string",
          "description": "The tag value.",
          "minLength": 0,
          "maxLength": 256,
          "pattern": "^([\\p{L}\\p{Z}\\p{N}_.:/=+\\-@]*)$"
        }
      },
      "required": [
        "Key",
        "Value"
      ]
    }
  },
  "properties": {
    "ClusterPeerId": {
      "type": "string",
      "description": "The system-generated, unique ID of the cluster peer relationship.",
      "pattern": "^(clusterpeer-[0-9a-f]{17})$"
    },
    "ResourceARN": {
      "type": "string",
      "description": "The Amazon Resource Name (ARN) of the cluster peer relationship.",
      "minLength": 8,
      "maxLength": 512,
      "pattern": ""
    },
    "FileSystemId": {
      "type": "string",
      "description": "The ID of the local file system.",
      "minLength": 11,
      "maxLength": 21,
      "pattern": "^(fs-[0-9a-f]{8,})$"
    },
    "PeerAddresses": {
      "type": "array",
      "description": "The intercluster IP addresses of the peer cluster, at least one.",
      "minItems": 1,
      "maxItems": 24,
      "uniqueItems": true,
      "insertionOrder": false,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 45,
        "pattern": "(^((([0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5])\\.){3}([0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5]))$|^(([0-9a-fA-F]{1,4}:){7,7}[0-9a-fA-F]{1,4}|([0-9a-fA-F]{1,4}:){1,7}:|([0-9a-fA-F]{1,4}:){1,6}:[0-9a-fA-F]{1,4}|([0-9a-fA-F]{1,4}:){1,5}(:[0-9a-fA-F]{1,4}){1,2}|([0-9a-fA-F]{1,4}:){1,4}(:[0-9a-fA-F]{1,4}){1,3}|([0-9a-fA-F]{1,4}:){1,3}(:[0-9a-fA-F]{1,4}){1,4}|([0-9a-fA-F]{1,4}:){1,2}(:[0-9a-fA-F]{1,4}){1,5}|[0-9a-fA-F]{1,4}:((:[0-9a-fA-F]{1,4}){1,6})|:((:[0-9a-fA-F]{1,4}){1,7}|:)|fe80:(:[0-9a-fA-F]{0,4}){0,4}%[0-9a-zA-Z]{1,}|::(ffff(:0{1,4}){0,1}:){0,1}((25[0-5]|(2[0-4]|1{0,1}[0-9]){0,1}[0-9])\\.){3,3}(25[0-5]|(2[0-4]|1{0,1}[0-9]){0,1}[0-9])|([0-9a-fA-F]{1,4}:){1,4}:((25[0-5]|(2[0-4]|1{0,1}[0-9]){0,1}[0-9])\\.){3,3}(25[0-5]|(2[0-4]|1{0,1}[0-9]){0,1}[0-9]))$)"
      }
    },
    "PassphraseSecretArn": {
      "type": "string",
      "description": "The ARN of an AWS Secrets Manager secret whose plain-text value is the cluster peering passphrase. Required when you create the cluster peer. Both sides of the relationship must use the same passphrase. The secret must allow FSx to read it.",
      "minLength": 64,
      "maxLength": 1024,
      "pattern": "^arn:[^:]{1,63}:secretsmanager:[a-z0-9-]+:[0-9]{12}:secret:[a-zA-Z0-9/_+=.@-]+-[a-zA-Z0-9]{6}$"
    },
    "PeerClusterName": {
      "type": "string",
      "description": "The ONTAP name of the peer cluster. After it is set, it can be changed but not removed; removing it from the template leaves the current name.",
      "minLength": 1,
      "maxLength": 44,
      "pattern": ""
    },
    "AllowedSvmMode": {
      "type": "string",
      "description": "Which local SVMs the peer cluster may peer with automatically: ALL, NONE, or SPECIFIED (the SVMs in AllowedSvmIds).",
      "enum": [
        "ALL",
        "NONE",
        "SPECIFIED"
      ]
    },
    "AllowedSvmIds": {
      "type": "array",
      "description": "The local SVMs the peer cluster may peer with automatically, when AllowedSvmMode is SPECIFIED.",
      "maxItems": 24,
      "uniqueItems": true,
      "insertionOrder": false,
      "items": {
        "type": "string",
        "description": "The ID of a local SVM.",
        "minLength": 21,
        "maxLength": 21,
        "pattern": "^(svm-[0-9a-f]{17,})$"
      }
    },
    "Status": {
      "type": "string",
      "description": "The ONTAP availability of the peer relationship, for example available or unavailable.",
      "minLength": 1,
      "maxLength": 64
    },
    "AuthenticationStatus": {
      "$ref": "#/definitions/AuthenticationStatus"
    },
    "UUID": {
      "type": "string",
      "description": "The ONTAP UUID of the cluster peer relationship.",
      "maxLength": 36,
      "pattern": ""
    },
    "Lifecycle": {
      "type": "string",
      "description": "The lifecycle status of the cluster peer relationship.",
      "enum": [
        "CREATING",
        "CREATED",
        "DELETING",
        "FAILED"
      ]
    },
    "Tags": {
      "type": "array",
      "description": "A list of tags to apply to the cluster peer relationship, with a maximum of 50 tags.",
      "maxItems": 50,
      "uniqueItems": false,
      "insertionOrder": false,
      "items": {
        "$ref": "#/definitions/Tag"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "FileSystemId",
    "PeerAddresses",
    "AllowedSvmMode"
  ],
  "readOnlyProperties": [
    "/properties/ClusterPeerId",
    "/properties/ResourceARN",
    "/properties/Status",
    "/properties/AuthenticationStatus",
    "/properties/UUID",
    "/properties/Lifecycle"
  ],
  "writeOnlyProperties": [
    "/properties/PassphraseSecretArn"
  ],
  "createOnlyProperties": [
    "/properties/FileSystemId",
    "/properties/PassphraseSecretArn",
    "/properties/AllowedSvmMode",
    "/properties/AllowedSvmIds"
  ],
  "primaryIdentifier": [
    "/properties/ResourceARN"
  ],
  "additionalIdentifiers": [
    [
      "/properties/ClusterPeerId"
    ]
  ],
  "tagging": {
    "taggable": true,
    "tagOnCreate": true,
    "tagUpdatable": true,
    "cloudFormationSystemTags": true,
    "tagProperty": "/properties/Tags",
    "permissions": [
      "fsx:ListTagsForResource",
      "fsx:TagResource",
      "fsx:UntagResource"
    ]
  },
  "handlers": {
    "create": {
      "permissions": [
        "fsx:CreateClusterPeer",
        "fsx:DescribeClusterPeers",
        "fsx:TagResource",
        "secretsmanager:GetSecretValue",
        "secretsmanager:DescribeSecret",
        "kms:Decrypt"
      ]
    },
    "read": {
      "permissions": [
        "fsx:DescribeClusterPeers",
        "fsx:ListTagsForResource"
      ]
    },
    "update": {
      "permissions": [
        "fsx:DescribeClusterPeers",
        "fsx:UpdateClusterPeer",
        "fsx:TagResource",
        "fsx:UntagResource"
      ]
    },
    "delete": {
      "permissions": [
        "fsx:DeleteClusterPeer",
        "fsx:DescribeClusterPeers"
      ]
    },
    "list": {
      "permissions": [
        "fsx:DescribeClusterPeers"
      ]
    }
  }
}
