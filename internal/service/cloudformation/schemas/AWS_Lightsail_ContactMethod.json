{
  "typeName": "AWS::Lightsail::ContactMethod",
  "description": "Resource Type definition for AWS::Lightsail::ContactMethod",
  "properties": {
    "Protocol": {
      "type": "string",
      "description": "The protocol of the contact method, such as Email or SMS (text messaging).",
      "enum": [
        "Email",
        "SMS"
      ]
    },
    "ContactEndpoint": {
      "type": "string",
      "description": "The destination of the contact method, such as an email address or a mobile phone number.",
      "minLength": 1,
      "maxLength": 256
    },
    "Arn": {
      "type": "string",
      "description": "The Amazon Resource Name (ARN) of the contact method.",
      "pattern": "^arn:aws(-[a-z]+)*:lightsail:[a-z0-9-]+:[0-9]+:ContactMethod/(Email|SMS)$"
    },
    "Status": {
      "type": "string",
      "description": "The current status of the contact method.",
      "enum": [
        "PendingVerification",
        "Valid",
        "Invalid"
      ]
    },
    "Name": {
      "type": "string",
      "description": "The name of the contact method."
    },
    "CreatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "The timestamp when the contact method was created."
    },
    "SupportCode": {
      "type": "string",
      "description": "The support code for the contact method."
    },
    "ResourceType": {
      "type": "string",
      "description": "The Lightsail resource type of the contact method."
    }
  },
  "required": [
    "Protocol",
    "ContactEndpoint"
  ],
  "additionalProperties": false,
  "readOnlyProperties": [
    "/properties/Arn",
    "/properties/Status",
    "/properties/Name",
    "/properties/CreatedAt",
    "/properties/SupportCode",
    "/properties/ResourceType"
  ],
  "createOnlyProperties": [
    "/properties/Protocol",
    "/properties/ContactEndpoint"
  ],
  "primaryIdentifier": [
    "/properties/Arn"
  ],
  "additionalIdentifiers": [
    [
      "/properties/Protocol"
    ]
  ],
  "tagging": {
    "taggable": false
  },
  "handlers": {
    "create": {
      "permissions": [
        "lightsail:CreateContactMethod",
        "lightsail:GetContactMethods"
      ]
    },
    "read": {
      "permissions": [
        "lightsail:GetContactMethods"
      ]
    },
    "delete": {
      "permissions": [
        "lightsail:DeleteContactMethod",
        "lightsail:GetContactMethods"
      ]
    },
    "list": {
      "permissions": [
        "lightsail:GetContactMethods"
      ]
    }
  }
}
