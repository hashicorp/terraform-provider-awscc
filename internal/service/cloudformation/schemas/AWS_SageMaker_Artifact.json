{
  "typeName": "AWS::SageMaker::Artifact",
  "description": "Resource type definition for AWS::SageMaker::Artifact. An artifact is a lineage tracking entity that represents a URI addressable object or data, such as an S3 URI of a dataset or the ECR registry path of an image.",
  "definitions": {
    "ArtifactSource": {
      "type": "object",
      "properties": {
        "SourceUri": {
          "type": "string",
          "description": "The URI of the source.",
          "minLength": 1,
          "maxLength": 2048
        },
        "SourceTypes": {
          "type": "array",
          "description": "A list of source types.",
          "items": {
            "$ref": "#/definitions/ArtifactSourceType"
          }
        }
      },
      "required": [
        "SourceUri"
      ],
      "additionalProperties": false
    },
    "ArtifactSourceType": {
      "type": "object",
      "properties": {
        "SourceIdType": {
          "type": "string",
          "description": "The type of ID.",
          "enum": [
            "MD5Hash",
            "S3ETag",
            "S3Version",
            "Custom"
          ]
        },
        "Value": {
          "type": "string",
          "description": "The ID.",
          "maxLength": 256
        }
      },
      "required": [
        "SourceIdType",
        "Value"
      ],
      "additionalProperties": false
    },
    "MetadataProperties": {
      "type": "object",
      "properties": {
        "CommitId": {
          "type": "string",
          "description": "The commit ID.",
          "maxLength": 1024
        },
        "Repository": {
          "type": "string",
          "description": "The repository.",
          "maxLength": 1024
        },
        "GeneratedBy": {
          "type": "string",
          "description": "The entity this entity was generated by.",
          "maxLength": 1024
        },
        "ProjectId": {
          "type": "string",
          "description": "The project ID.",
          "maxLength": 1024
        }
      },
      "additionalProperties": false
    },
    "Tag": {
      "type": "object",
      "properties": {
        "Key": {
          "type": "string",
          "description": "The tag key.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^([\\p{L}\\p{Z}\\p{N}_.:/=+\\-@]*)$"
        },
        "Value": {
          "type": "string",
          "description": "The tag value.",
          "maxLength": 256,
          "pattern": "^([\\p{L}\\p{Z}\\p{N}_.:/=+\\-@]*)$"
        }
      },
      "required": [
        "Key",
        "Value"
      ],
      "additionalProperties": false
    }
  },
  "properties": {
    "ArtifactName": {
      "type": "string",
      "description": "The name of the artifact. Must be unique to your account in an AWS Region.",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[a-zA-Z0-9](-*[a-zA-Z0-9]){0,119}$"
    },
    "ArtifactType": {
      "type": "string",
      "description": "The artifact type.",
      "maxLength": 256
    },
    "Source": {
      "$ref": "#/definitions/ArtifactSource",
      "description": "The source of the artifact."
    },
    "Properties": {
      "type": "object",
      "description": "A list of properties to add to the artifact.",
      "patternProperties": {
        "": {
          "type": "string",
          "maxLength": 4096
        }
      },
      "additionalProperties": false,
      "maxProperties": 30
    },
    "MetadataProperties": {
      "$ref": "#/definitions/MetadataProperties",
      "description": "Metadata properties of the tracking entity, trial, or trial component."
    },
    "Tags": {
      "type": "array",
      "description": "A list of tags to apply to the artifact.",
      "items": {
        "$ref": "#/definitions/Tag"
      },
      "maxItems": 50
    },
    "Arn": {
      "type": "string",
      "description": "The Amazon Resource Name (ARN) of the artifact.",
      "maxLength": 256,
      "pattern": "^arn:aws[a-z\\-]*:sagemaker:[a-z0-9\\-]*:[0-9]{12}:artifact/"
    },
    "CreationTime": {
      "type": "string",
      "format": "date-time",
      "description": "When the artifact was created."
    },
    "LastModifiedTime": {
      "type": "string",
      "format": "date-time",
      "description": "When the artifact was last modified."
    }
  },
  "required": [
    "ArtifactType",
    "Source"
  ],
  "readOnlyProperties": [
    "/properties/Arn",
    "/properties/CreationTime",
    "/properties/LastModifiedTime"
  ],
  "createOnlyProperties": [
    "/properties/ArtifactType",
    "/properties/Source",
    "/properties/MetadataProperties"
  ],
  "primaryIdentifier": [
    "/properties/Arn"
  ],
  "tagging": {
    "taggable": true,
    "tagOnCreate": true,
    "tagUpdatable": true,
    "cloudFormationSystemTags": false,
    "tagProperty": "/properties/Tags",
    "permissions": [
      "sagemaker:AddTags",
      "sagemaker:DeleteTags",
      "sagemaker:ListTags"
    ]
  },
  "handlers": {
    "create": {
      "permissions": [
        "sagemaker:CreateArtifact",
        "sagemaker:DescribeArtifact",
        "sagemaker:AddTags",
        "sagemaker:ListTags"
      ]
    },
    "read": {
      "permissions": [
        "sagemaker:DescribeArtifact",
        "sagemaker:ListTags"
      ]
    },
    "update": {
      "permissions": [
        "sagemaker:UpdateArtifact",
        "sagemaker:DescribeArtifact",
        "sagemaker:AddTags",
        "sagemaker:DeleteTags",
        "sagemaker:ListTags"
      ]
    },
    "delete": {
      "permissions": [
        "sagemaker:DeleteArtifact",
        "sagemaker:DescribeArtifact",
        "sagemaker:ListTags"
      ]
    },
    "list": {
      "permissions": [
        "sagemaker:ListArtifacts"
      ]
    }
  },
  "additionalProperties": false
}
