{
  "typeName": "AWS::Personalize::Filter",
  "description": "A recommendation filter that defines which items are included or excluded from recommendations.",
  "definitions": {
    "Tag": {
      "type": "object",
      "description": "A key-value pair to associate with a resource.",
      "properties": {
        "Key": {
          "type": "string",
          "description": "The key name of the tag.",
          "minLength": 1,
          "maxLength": 128
        },
        "Value": {
          "type": "string",
          "description": "The value for the tag.",
          "minLength": 0,
          "maxLength": 256
        }
      },
      "required": [
        "Key",
        "Value"
      ],
      "additionalProperties": false
    }
  },
  "properties": {
    "Name": {
      "type": "string",
      "description": "The name of the filter.",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9\\-_]*$"
    },
    "DatasetGroupArn": {
      "type": "string",
      "description": "The ARN of the dataset group that the filter belongs to.",
      "maxLength": 256,
      "pattern": "arn:([a-z\\d-]+):personalize:.*:.*:.+"
    },
    "FilterExpression": {
      "type": "string",
      "description": "The filter expression that defines which items are included or excluded from recommendations.",
      "minLength": 1,
      "maxLength": 2500
    },
    "FilterArn": {
      "type": "string",
      "description": "The ARN of the filter.",
      "maxLength": 256,
      "pattern": "arn:([a-z\\d-]+):personalize:.*:.*:.+"
    },
    "Status": {
      "type": "string",
      "description": "The status of the filter.",
      "maxLength": 256
    },
    "CreationDateTime": {
      "type": "string",
      "description": "The time at which the filter was created.",
      "format": "date-time"
    },
    "LastUpdatedDateTime": {
      "type": "string",
      "description": "The time at which the filter was last updated.",
      "format": "date-time"
    },
    "Tags": {
      "type": "array",
      "description": "Tags to associate with the filter.",
      "uniqueItems": true,
      "insertionOrder": false,
      "items": {
        "$ref": "#/definitions/Tag"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "Name",
    "DatasetGroupArn",
    "FilterExpression"
  ],
  "readOnlyProperties": [
    "/properties/FilterArn",
    "/properties/Status",
    "/properties/CreationDateTime",
    "/properties/LastUpdatedDateTime"
  ],
  "createOnlyProperties": [
    "/properties/Name",
    "/properties/DatasetGroupArn",
    "/properties/FilterExpression"
  ],
  "primaryIdentifier": [
    "/properties/FilterArn"
  ],
  "tagging": {
    "taggable": true,
    "tagOnCreate": true,
    "tagUpdatable": true,
    "cloudFormationSystemTags": false,
    "tagProperty": "/properties/Tags",
    "permissions": [
      "personalize:TagResource",
      "personalize:UntagResource",
      "personalize:ListTagsForResource"
    ]
  },
  "handlers": {
    "create": {
      "permissions": [
        "personalize:CreateFilter",
        "personalize:DescribeFilter",
        "personalize:TagResource",
        "personalize:ListTagsForResource"
      ]
    },
    "read": {
      "permissions": [
        "personalize:DescribeFilter",
        "personalize:ListTagsForResource"
      ]
    },
    "update": {
      "permissions": [
        "personalize:DescribeFilter",
        "personalize:TagResource",
        "personalize:UntagResource",
        "personalize:ListTagsForResource"
      ]
    },
    "delete": {
      "permissions": [
        "personalize:DeleteFilter",
        "personalize:DescribeFilter"
      ]
    },
    "list": {
      "permissions": [
        "personalize:ListFilters"
      ]
    }
  }
}
