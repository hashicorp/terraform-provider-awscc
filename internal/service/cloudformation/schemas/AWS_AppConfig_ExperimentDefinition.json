{
  "tagging": {
    "permissions": [
      "appconfig:TagResource",
      "appconfig:UntagResource",
      "appconfig:ListTagsForResource"
    ],
    "taggable": true,
    "tagOnCreate": true,
    "tagUpdatable": true,
    "tagProperty": "/properties/Tags",
    "cloudFormationSystemTags": true
  },
  "typeName": "AWS::AppConfig::ExperimentDefinition",
  "readOnlyProperties": [
    "/properties/ApplicationId",
    "/properties/Id",
    "/properties/Status",
    "/properties/CreatedAt",
    "/properties/UpdatedAt",
    "/properties/Control/Key",
    "/properties/Treatments/*/Key"
  ],
  "description": "Resource Type definition for AWS::AppConfig::ExperimentDefinition",
  "createOnlyProperties": [
    "/properties/ApplicationIdentifier",
    "/properties/Name",
    "/properties/ConfigurationProfileIdentifier",
    "/properties/EnvironmentIdentifier",
    "/properties/FlagKey"
  ],
  "primaryIdentifier": [
    "/properties/ApplicationId",
    "/properties/Id"
  ],
  "required": [
    "ApplicationIdentifier",
    "Name",
    "ConfigurationProfileIdentifier",
    "EnvironmentIdentifier",
    "FlagKey",
    "Treatments",
    "Control",
    "AudienceRule"
  ],
  "sourceUrl": "https://github.com/aws-cloudformation/aws-cloudformation-resource-providers-appconfig.git",
  "handlers": {
    "read": {
      "permissions": [
        "appconfig:GetExperimentDefinition",
        "appconfig:ListTagsForResource"
      ]
    },
    "create": {
      "permissions": [
        "appconfig:CreateExperimentDefinition",
        "appconfig:GetExperimentDefinition",
        "appconfig:TagResource",
        "appconfig:ListTagsForResource"
      ]
    },
    "update": {
      "permissions": [
        "appconfig:UpdateExperimentDefinition",
        "appconfig:GetExperimentDefinition",
        "appconfig:TagResource",
        "appconfig:UntagResource",
        "appconfig:ListTagsForResource"
      ]
    },
    "list": {
      "permissions": [
        "appconfig:ListExperimentDefinitions"
      ],
      "handlerSchema": {
        "properties": {
          "ApplicationIdentifier": {
            "$ref": "resource-schema.json#/properties/ApplicationIdentifier"
          }
        },
        "required": [
          "ApplicationIdentifier"
        ]
      }
    },
    "delete": {
      "permissions": [
        "appconfig:DeleteExperimentDefinition",
        "appconfig:GetExperimentDefinition"
      ]
    }
  },
  "additionalIdentifiers": [
    [
      "/properties/ApplicationIdentifier",
      "/properties/Name"
    ]
  ],
  "additionalProperties": false,
  "definitions": {
    "AttributeValue": {
      "description": "A typed attribute value for a treatment flag.",
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "StringArray": {
          "description": "An array of string values.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "NumberValue": {
          "description": "A numeric value.",
          "type": "number"
        },
        "BooleanValue": {
          "description": "A boolean value.",
          "type": "boolean"
        },
        "StringValue": {
          "description": "A string value.",
          "type": "string"
        },
        "NumberArray": {
          "description": "An array of numeric values.",
          "type": "array",
          "items": {
            "type": "number"
          }
        }
      }
    },
    "Treatment": {
      "description": "A treatment variant with weight and flag value. The Key is auto-generated by the service.",
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "Description": {
          "type": "string",
          "maxLength": 1024
        },
        "AttributeValues": {
          "patternProperties": {
            "": {
              "$ref": "#/definitions/AttributeValue"
            }
          },
          "description": "Map of attribute name to attribute value.",
          "additionalProperties": false,
          "type": "object"
        },
        "Enabled": {
          "description": "Whether the flag is enabled for this variant.",
          "type": "boolean"
        },
        "Key": {
          "description": "The treatment key (read-only, auto-generated by service).",
          "type": "string"
        },
        "Weight": {
          "description": "Traffic weight percentage.",
          "type": "number"
        }
      },
      "required": [
        "Weight",
        "Enabled"
      ]
    },
    "Tag": {
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "Value": {
          "minLength": 0,
          "description": "The tag value.",
          "type": "string",
          "maxLength": 256
        },
        "Key": {
          "minLength": 1,
          "description": "The tag key.",
          "type": "string",
          "maxLength": 128
        }
      },
      "required": [
        "Key",
        "Value"
      ]
    }
  },
  "properties": {
    "Status": {
      "description": "Current status.",
      "type": "string",
      "enum": [
        "ACTIVE",
        "IDLE",
        "ARCHIVED"
      ]
    },
    "EnvironmentIdentifier": {
      "minLength": 1,
      "description": "The environment ID, name, or ARN.",
      "type": "string",
      "maxLength": 2048
    },
    "AudienceDescription": {
      "description": "Human-readable description of the audience.",
      "type": "string",
      "maxLength": 1024
    },
    "CreatedAt": {
      "description": "ISO-8601 creation timestamp.",
      "type": "string"
    },
    "LaunchCriteria": {
      "description": "Criteria for launching the experiment.",
      "type": "string",
      "maxLength": 1024
    },
    "ApplicationIdentifier": {
      "minLength": 1,
      "description": "The application ID, name, or ARN.",
      "type": "string",
      "maxLength": 2048
    },
    "AudienceRule": {
      "description": "Rule expression defining the experiment audience.",
      "type": "string",
      "maxLength": 16384
    },
    "UpdatedAt": {
      "description": "ISO-8601 last update timestamp.",
      "type": "string"
    },
    "Hypothesis": {
      "description": "The hypothesis of the experiment.",
      "type": "string",
      "maxLength": 1024
    },
    "Name": {
      "minLength": 1,
      "description": "A name for the experiment definition.",
      "type": "string",
      "maxLength": 64
    },
    "ConfigurationProfileIdentifier": {
      "minLength": 1,
      "description": "The configuration profile ID, name, or ARN.",
      "type": "string",
      "maxLength": 2048
    },
    "Control": {
      "description": "The control (baseline) variant.",
      "$ref": "#/definitions/Treatment"
    },
    "FlagKey": {
      "minLength": 1,
      "description": "The key of the existing flag in the configuration profile to experiment on.",
      "type": "string",
      "maxLength": 64
    },
    "Id": {
      "pattern": "[a-z0-9]{4,7}",
      "description": "The experiment definition ID.",
      "type": "string"
    },
    "ApplicationId": {
      "pattern": "[a-z0-9]{4,7}",
      "description": "The resolved application ID (read-only, assigned by service).",
      "type": "string"
    },
    "Treatments": {
      "minItems": 1,
      "maxItems": 5,
      "description": "Treatment variants (1-5).",
      "type": "array",
      "items": {
        "$ref": "#/definitions/Treatment"
      }
    },
    "Tags": {
      "uniqueItems": true,
      "description": "Tags to associate with the experiment definition.",
      "insertionOrder": false,
      "type": "array",
      "items": {
        "$ref": "#/definitions/Tag"
      }
    }
  }
}
