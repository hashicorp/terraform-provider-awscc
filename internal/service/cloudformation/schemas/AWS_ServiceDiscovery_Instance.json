      "maxLength": 64
    },
    "ServiceId": {
      "type": "string",
      "description": "The ID or Amazon Resource Name (ARN) of the service that you want to use for settings for the instance.",
      "minLength": 1,
      "maxLength": 255
    }
  },
  "tagging": {
    "taggable": false
  },
  "required": [
