    "/properties/ServiceId",
    "/properties/InstanceId"
  ],
  "handlers": {
    "create": {
      "permissions": [
        "servicediscovery:RegisterInstance",
        "servicediscovery:GetInstance",
        "servicediscovery:GetOperation"
      ]
    },
    "read": {
