{
  "typeName": "AWS::MGN::Wave",
  "description": "Resource schema for AWS::MGN::Wave. A Wave is a logical grouping used in Application Migration Service to organize and manage the migration of applications.",
  "properties": {
    "WaveID": {
      "type": "string",
      "description": "The unique identifier of the wave.",
      "minLength": 22,
      "maxLength": 22,
      "pattern": "^wave-[0-9a-zA-Z]{17}$"
    },
    "Arn": {
      "type": "string",
      "description": "The Amazon Resource Name (ARN) of the wave.",
      "minLength": 20,
      "maxLength": 2048
    },
    "Name": {
      "type": "string",
      "description": "The name of the wave.",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\s\\x00]( *[^\\s\\x00])*$"
    },
    "Description": {
      "type": "string",
      "description": "A description of the wave.",
      "minLength": 0,
      "maxLength": 600,
      "pattern": "^[^\\x00]*$"
    },
    "IsArchived": {
      "type": "boolean",
      "description": "Whether the wave is archived."
    },
    "WaveAggregatedStatus": {
      "$ref": "#/definitions/WaveAggregatedStatus",
      "description": "The aggregated migration status of the wave."
    },
    "CreationDateTime": {
      "type": "string",
      "description": "The timestamp when the wave was created.",
      "minLength": 19,
      "maxLength": 32,
      "pattern": "^[1-9][0-9]*-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([0-1][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "LastModifiedDateTime": {
      "type": "string",
      "description": "The timestamp when the wave was last modified.",
      "minLength": 19,
      "maxLength": 32,
      "pattern": "^[1-9][0-9]*-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([0-1][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "Tags": {
      "type": "array",
      "description": "Tags to assign to the wave.",
      "uniqueItems": true,
      "insertionOrder": false,
      "maxItems": 50,
      "items": {
        "$ref": "#/definitions/Tag"
      }
    }
  },
  "definitions": {
    "WaveAggregatedStatus": {
      "type": "object",
      "description": "The aggregated migration status of the wave.",
      "properties": {
        "HealthStatus": {
          "type": "string",
          "description": "The health status of the wave.",
          "enum": [
            "HEALTHY",
            "LAGGING",
            "ERROR"
          ]
        },
        "ProgressStatus": {
          "type": "string",
          "description": "The progress status of the wave.",
          "enum": [
            "NOT_STARTED",
            "IN_PROGRESS",
            "COMPLETED"
          ]
        },
        "TotalApplications": {
          "type": "integer",
          "description": "The total number of applications in the wave.",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "Tag": {
      "type": "object",
      "description": "A key-value pair to associate with a resource.",
      "properties": {
        "Key": {
          "type": "string",
          "description": "The key name of the tag.",
          "minLength": 0,
          "maxLength": 256
        },
        "Value": {
          "type": "string",
          "description": "The value for the tag.",
          "minLength": 0,
          "maxLength": 256
        }
      },
      "required": [
        "Key",
        "Value"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "Name"
  ],
  "readOnlyProperties": [
    "/properties/WaveID",
    "/properties/Arn",
    "/properties/IsArchived",
    "/properties/WaveAggregatedStatus",
    "/properties/CreationDateTime",
    "/properties/LastModifiedDateTime"
  ],
  "primaryIdentifier": [
    "/properties/Arn"
  ],
  "additionalIdentifiers": [
    [
      "/properties/WaveID"
    ]
  ],
  "additionalProperties": false,
  "tagging": {
    "taggable": true,
    "tagOnCreate": true,
    "tagUpdatable": true,
    "cloudFormationSystemTags": false,
    "tagProperty": "/properties/Tags",
    "permissions": [
      "mgn:TagResource",
      "mgn:UntagResource",
      "mgn:ListTagsForResource"
    ]
  },
  "handlers": {
    "create": {
      "permissions": [
        "mgn:CreateWave",
        "mgn:ListWaves",
        "mgn:TagResource",
        "mgn:ListTagsForResource"
      ]
    },
    "read": {
      "permissions": [
        "mgn:ListWaves",
        "mgn:ListTagsForResource"
      ]
    },
    "update": {
      "permissions": [
        "mgn:UpdateWave",
        "mgn:ListWaves",
        "mgn:TagResource",
        "mgn:UntagResource",
        "mgn:ListTagsForResource"
      ]
    },
    "delete": {
      "permissions": [
        "mgn:DeleteWave",
        "mgn:ListWaves",
        "mgn:ListTagsForResource"
      ]
    },
    "list": {
      "permissions": [
        "mgn:ListWaves"
      ]
    }
  }
}
