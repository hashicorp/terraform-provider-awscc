{
  "typeName": "AWS::APIPortal::DiscoveryEnablement",
  "description": "Resource Type definition for AWS::APIPortal::DiscoveryEnablement. Starts API discovery for an AWS::APIPortal::DiscoveryConfiguration or AWS::APIPortal::OrganizationDiscoveryConfiguration while it exists, and stops discovery when it is deleted.",
  "sourceUrl": "https://github.com/aws-cloudformation/aws-cloudformation-resource-providers-apiportal.git",
  "properties": {
    "Id": {
      "type": "string",
      "description": "The ARN of the account discovery configuration or organization discovery configuration to run discovery for.",
      "pattern": "^arn:aws[a-z\\-]*:apiportal:[a-z0-9\\-]*:[0-9]{12}:(discoveryconfiguration|orgdiscoveryconfiguration)$",
      "minLength": 20,
      "maxLength": 1011
    }
  },
  "additionalProperties": false,
  "required": [
    "Id"
  ],
  "createOnlyProperties": [
    "/properties/Id"
  ],
  "primaryIdentifier": [
    "/properties/Id"
  ],
  "tagging": {
    "taggable": false
  },
  "handlers": {
    "create": {
      "permissions": [
        "apiportal:StartDiscovery",
        "apiportal:GetDiscoveryConfiguration",
        "apiportal:GetOrganizationDiscoveryConfiguration",
        "apiportal:ListDiscoveryStatuses",
        "organizations:ListAWSServiceAccessForOrganization"
      ]
    },
    "read": {
      "permissions": [
        "apiportal:ListDiscoveryStatuses",
        "organizations:ListAWSServiceAccessForOrganization"
      ]
    },
    "delete": {
      "permissions": [
        "apiportal:StopDiscovery",
        "apiportal:GetDiscoveryConfiguration",
        "apiportal:GetOrganizationDiscoveryConfiguration",
        "apiportal:ListDiscoveryStatuses",
        "organizations:ListAWSServiceAccessForOrganization"
      ]
    }
  }
}
