{
  "typeName": "AWS::Rekognition::Dataset",
  "description": "The AWS::Rekognition::Dataset type creates an Amazon Rekognition Custom Labels dataset.",
  "properties": {
    "DatasetArn": {
      "type": "string",
      "description": "The ARN of the dataset.",
      "minLength": 20,
      "maxLength": 2048,
      "pattern": "^(^arn:[a-z\\d-]+:rekognition:[a-z\\d-]+:\\d{12}:project\\/[a-zA-Z0-9_.\\-]{1,255}\\/dataset\\/(train|test)\\/[0-9]+$)$"
    },
    "ProjectArn": {
      "type": "string",
      "description": "The ARN of the project to which the dataset belongs.",
      "minLength": 20,
      "maxLength": 2048,
      "pattern": "^(^arn:[a-z\\d-]+:rekognition:[a-z\\d-]+:\\d{12}:project\\/[a-zA-Z0-9_.\\-]{1,255}\\/[0-9]+$)$"
    },
    "DatasetType": {
      "type": "string",
      "description": "The type of the dataset. Specify TRAIN to create a training dataset. Specify TEST to create a test dataset.",
      "enum": [
        "TRAIN",
        "TEST"
      ]
    },
    "Tags": {
      "type": "array",
      "description": "An array of key-value pairs to apply to this resource.",
      "uniqueItems": true,
      "insertionOrder": false,
      "items": {
        "$ref": "#/definitions/Tag"
      },
      "maxItems": 200
    }
  },
  "definitions": {
    "Tag": {
      "type": "object",
      "description": "A key-value pair to associate with a resource.",
      "properties": {
        "Key": {
          "type": "string",
          "description": "The key name of the tag.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": ""
        },
        "Value": {
          "type": "string",
          "description": "The value for the tag.",
          "minLength": 0,
          "maxLength": 256,
          "pattern": "^([\\p{L}\\p{Z}\\p{N}_.:/=+\\-@]*)$"
        }
      },
      "required": [
        "Key",
        "Value"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "DatasetType"
  ],
  "additionalProperties": false,
  "readOnlyProperties": [
    "/properties/DatasetArn"
  ],
  "writeOnlyProperties": [
    "/properties/ProjectArn"
  ],
  "createOnlyProperties": [
    "/properties/DatasetType",
    "/properties/ProjectArn"
  ],
  "primaryIdentifier": [
    "/properties/DatasetArn"
  ],
  "tagging": {
    "taggable": true,
    "tagOnCreate": true,
    "tagUpdatable": true,
    "cloudFormationSystemTags": false,
    "tagProperty": "/properties/Tags",
    "permissions": [
      "rekognition:TagResource",
      "rekognition:UntagResource",
      "rekognition:ListTagsForResource"
    ]
  },
  "handlers": {
    "create": {
      "permissions": [
        "rekognition:CreateDataset",
        "rekognition:DescribeDataset",
        "rekognition:TagResource",
        "rekognition:ListTagsForResource"
      ]
    },
    "read": {
      "permissions": [
        "rekognition:DescribeDataset",
        "rekognition:ListTagsForResource"
      ]
    },
    "update": {
      "permissions": [
        "rekognition:TagResource",
        "rekognition:UntagResource",
        "rekognition:ListTagsForResource",
        "rekognition:DescribeDataset"
      ]
    },
    "delete": {
      "permissions": [
        "rekognition:DeleteDataset",
        "rekognition:DescribeDataset",
        "rekognition:ListTagsForResource"
      ]
    },
    "list": {
      "handlerSchema": {
        "properties": {
          "ProjectArn": {
            "type": "string",
            "minLength": 20,
            "maxLength": 2048,
            "pattern": "^(^arn:[a-z\\d-]+:rekognition:[a-z\\d-]+:\\d{12}:project\\/[a-zA-Z0-9_.\\-]{1,255}\\/[0-9]+$)$"
          }
        },
        "required": [
          "ProjectArn"
        ]
      },
      "permissions": [
        "rekognition:DescribeProjects"
      ]
    }
  }
}
