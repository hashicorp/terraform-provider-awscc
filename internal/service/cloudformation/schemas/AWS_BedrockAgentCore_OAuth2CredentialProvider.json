        "PrivateKeyJwtConfig": {
          "$ref": "#/definitions/PrivateKeyJwtConfig"
        },
        "PrivateEndpoint": {
          "$ref": "#/definitions/PrivateEndpoint"
        },
        "PrivateEndpointOverrides": {
          "type": "array",
