            "NONE",
            "M2M",
            "AWS_IAM_ID_TOKEN_JWT"
          ]
        },
        "ActorTokenScopes": {
          "type": "array",
          "description": "The actor token scopes. Only valid when ActorTokenContent is M2M.",
