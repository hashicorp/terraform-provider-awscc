{
  "typeName": "AWS::BedrockAgentCore::ConsentPortal",
  "description": "Resource Type definition for AWS::BedrockAgentCore::ConsentPortal",
  "definitions": {
    "Tag": {
      "type": "object",
      "properties": {
        "Key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9\\s._:/=+@-]*$"
        },
        "Value": {
          "type": "string",
          "minLength": 0,
          "maxLength": 256,
          "pattern": "^[a-zA-Z0-9\\s._:/=+@-]*$"
        }
      },
      "required": [
        "Key",
        "Value"
      ],
      "additionalProperties": false
    },
    "TagsMap": {
      "type": "object",
      "description": "A map of tags (key-value pairs) to apply to a resource",
      "patternProperties": {
        "": {
          "type": "string",
          "minLength": 0,
          "maxLength": 256,
          "pattern": "^[a-zA-Z0-9\\s._:/=+@-]*$"
        }
      },
      "additionalProperties": false,
      "maxProperties": 50
    },
    "IdpConfig": {
      "type": "object",
      "properties": {
        "CredentialProviderArn": {
          "type": "string",
          "description": "The ARN of an AWS::BedrockAgentCore::OAuth2CredentialProvider resource.",
          "pattern": "^arn:(aws|aws-cn|aws-us-gov|aws-iso|aws-iso-b|aws-iso-e|aws-iso-f|aws-eusc):bedrock-agentcore:[a-z0-9-]{1,32}:[0-9]{12}:token-vault/[a-zA-Z0-9_-]{1,64}/oauth2credentialprovider/[a-zA-Z0-9_-]{1,128}$"
        },
        "Scopes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "Audience": {
          "type": "string"
        }
      },
      "required": [
        "CredentialProviderArn",
        "Scopes"
      ],
      "additionalProperties": false
    },
    "ConsentPortalSource": {
      "type": "object",
      "properties": {
        "Identifier": {
          "type": "string",
          "pattern": "^([0-9a-z][-]?){1,100}-[0-9a-z]{10}$|^arn:aws(-[a-z-]+)?:bedrock-agentcore:[a-z0-9-]{1,20}:[0-9]{12}:gateway/([0-9a-z][-]?){1,48}-[a-z0-9]{10}$"
        },
        "Type": {
          "type": "string",
          "enum": [
            "agentcore-gateway"
          ]
        }
      },
      "required": [
        "Identifier",
        "Type"
      ],
      "additionalProperties": false
    }
  },
  "properties": {
    "ExecutionRoleArn": {
      "type": "string",
      "pattern": "^arn:aws(-[a-z-]+)?:iam::[0-9]{12}:role/[a-zA-Z0-9+=,.@\\-_/]+$"
    },
    "IdpConfig": {
      "$ref": "#/definitions/IdpConfig"
    },
    "Name": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]{1,50}$",
      "minLength": 1,
      "maxLength": 50
    },
    "Sources": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/ConsentPortalSource"
      },
      "minItems": 1,
      "maxItems": 1
    },
    "Description": {
      "type": "string",
      "maxLength": 512
    },
    "ConsentPortalId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9\\-_]{1,50}-[A-Za-z0-9]{10}$"
    },
    "CreatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "PortalUrl": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "Status": {
      "type": "string",
      "enum": [
        "CREATING",
        "ACTIVE",
        "UPDATING",
        "UPDATE_FAILED",
        "DELETING",
        "FAILED"
      ]
    },
    "UpdatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "ConsentPortalArn": {
      "type": "string",
      "description": "The Amazon Resource Name (ARN) of the resource.",
      "pattern": "^arn:[^:]+:bedrock-agentcore:[^:]*:[0-9]{12}:consent-portal/(?:[a-zA-Z0-9\\-_]{1,50}-[A-Za-z0-9]{10})$"
    },
    "Tags": {
      "type": "array",
      "description": "Tags to assign to the consent portal",
      "items": {
        "$ref": "#/definitions/Tag"
      },
      "maxItems": 50,
      "insertionOrder": false
    }
  },
  "primaryIdentifier": [
