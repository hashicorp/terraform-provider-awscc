{
  "typeName": "AWS::OSIS::PipelineEndpoint",
  "description": "Creates a VPC endpoint for an OpenSearch Ingestion pipeline, enabling private connectivity between your VPC and the pipeline.",
  "properties": {
    "Arn": {
      "type": "string",
      "description": "The Amazon Resource Name (ARN) of the pipeline endpoint.",
      "pattern": "^arn:(aws|aws-cn|aws-us-gov|aws-iso|aws-iso-b):osis:.+:endpoint/.+$"
    },
    "EndpointId": {
      "type": "string",
      "description": "The unique identifier of the pipeline endpoint.",
      "minLength": 3,
      "maxLength": 512,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9-_]+$"
    },
    "PipelineArn": {
      "type": "string",
      "description": "The Amazon Resource Name (ARN) of the pipeline to create the endpoint for.",
      "minLength": 46,
      "maxLength": 76,
      "pattern": "^arn:(aws|aws-cn|aws-us-gov|aws-iso|aws-iso-b):osis:.+:pipeline/.+$"
    },
    "VpcOptions": {
      "$ref": "#/definitions/VpcOptions"
    },
    "Status": {
      "type": "string",
      "description": "The current status of the pipeline endpoint.",
      "enum": [
        "CREATING",
        "ACTIVE",
        "CREATE_FAILED",
        "DELETING",
        "REVOKING",
        "REVOKED"
      ]
    },
    "VpcId": {
      "type": "string",
      "description": "The ID of the VPC where the pipeline endpoint was created."
    },
    "IngestEndpointUrl": {
      "type": "string",
      "description": "The URL used to ingest data to the pipeline through the VPC endpoint."
    }
  },
  "definitions": {
    "VpcOptions": {
      "type": "object",
      "description": "Configuration settings for the VPC endpoint.",
      "properties": {
        "SubnetIds": {
          "type": "array",
          "description": "A list of subnet IDs where the pipeline endpoint network interfaces are created.",
          "items": {
            "type": "string",
            "minLength": 15,
            "maxLength": 24,
            "pattern": "^subnet-\\w{8}(\\w{9})?$"
          },
          "minItems": 1,
          "maxItems": 12
        },
        "SecurityGroupIds": {
          "type": "array",
          "description": "A list of security group IDs that control network access to the pipeline endpoint.",
          "items": {
            "type": "string",
            "minLength": 11,
            "maxLength": 20,
            "pattern": "^sg-\\w{8}(\\w{9})?$"
          },
          "minItems": 1,
          "maxItems": 12
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "PipelineArn",
    "VpcOptions"
  ],
  "additionalProperties": false,
  "readOnlyProperties": [
    "/properties/Arn",
    "/properties/EndpointId",
    "/properties/Status",
    "/properties/VpcId",
    "/properties/IngestEndpointUrl"
  ],
  "createOnlyProperties": [
    "/properties/PipelineArn",
    "/properties/VpcOptions"
  ],
  "primaryIdentifier": [
    "/properties/Arn"
  ],
  "additionalIdentifiers": [
    [
      "/properties/EndpointId"
    ]
  ],
  "tagging": {
    "taggable": false
  },
  "handlers": {
    "create": {
      "permissions": [
        "osis:CreatePipelineEndpoint",
        "osis:ListPipelineEndpoints",
        "iam:CreateServiceLinkedRole"
      ]
    },
    "read": {
      "permissions": [
        "osis:ListPipelineEndpoints"
      ]
    },
    "delete": {
      "permissions": [
        "osis:DeletePipelineEndpoint",
        "osis:ListPipelineEndpoints"
      ]
    },
    "list": {
      "permissions": [
        "osis:ListPipelineEndpoints"
      ]
    }
  }
}
