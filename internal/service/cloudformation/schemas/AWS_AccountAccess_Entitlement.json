{
  "typeName": "AWS::AccountAccess::Entitlement",
  "description": "Resource Type definition for AWS::AccountAccess::Entitlement specifying an entitlement for account access",
  "sourceUrl": "https://github.com/aws-cloudformation/aws-cloudformation-resource-providers-accountaccess.git",
  "resourceLink": {
    "templateUri": "/account-access/home?region=${awsRegion}#/entitlement/${EntitlementId}",
    "mappings": {
      "EntitlementId": "/EntitlementId"
    }
  },
  "definitions": {
    "IdentityCenterPrincipal": {
      "type": "object",
      "properties": {
        "UserId": {
          "type": "string",
          "description": "The ID of the user",
          "minLength": 1,
          "maxLength": 47,
          "pattern": "^([0-9a-f]{10}-|)[A-Fa-f0-9]{8}-[A-Fa-f0-9]{4}-[A-Fa-f0-9]{4}-[A-Fa-f0-9]{4}-[A-Fa-f0-9]{12}$"
        },
        "GroupId": {
          "type": "string",
          "description": "The ID of the group",
          "minLength": 1,
          "maxLength": 47,
          "pattern": "^([0-9a-f]{10}-|)[A-Fa-f0-9]{8}-[A-Fa-f0-9]{4}-[A-Fa-f0-9]{4}-[A-Fa-f0-9]{4}-[A-Fa-f0-9]{12}$"
        }
      },
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "UserId"
          ]
        },
        {
          "required": [
            "GroupId"
          ]
        }
      ]
    },
    "Principal": {
      "type": "object",
      "properties": {
        "IdentityCenter": {
          "$ref": "#/definitions/IdentityCenterPrincipal"
        }
      },
      "required": [
        "IdentityCenter"
      ],
      "additionalProperties": false
    },
    "PrincipalRoleEntitlement": {
      "type": "object",
      "properties": {
        "Principal": {
          "$ref": "#/definitions/Principal"
        },
        "RoleArn": {
          "description": "The ARN of the IAM role",
          "type": "string",
          "pattern": "^arn:[a-z0-9-]+:iam::[0-9]{12}:role\\/([a-zA-Z0-9+=,.@_-]+\\/)*[a-zA-Z0-9+=,.@_-]+$"
        },
        "Account": {
          "description": "The AWS account ID",
          "type": "string",
          "pattern": "^[0-9]{12}$",
          "minLength": 12,
          "maxLength": 12
        }
      },
      "required": [
        "Principal",
        "RoleArn"
      ],
      "additionalProperties": false
    },
    "Entitlement": {
      "type": "object",
      "properties": {
        "PrincipalRole": {
          "$ref": "#/definitions/PrincipalRoleEntitlement"
        }
      },
      "required": [
        "PrincipalRole"
      ],
      "additionalProperties": false
    }
  },
  "properties": {
    "ApplicationArn": {
      "description": "The ARN of the application",
      "type": "string",
      "pattern": "^arn:[a-z0-9-]+:account-access:[a-z0-9]+(-[a-z0-9]+)*:[0-9]{12}:application/[a-zA-Z0-9-]+$"
    },
    "EntitlementId": {
      "description": "The ID of the entitlement",
      "type": "string"
    },
    "Entitlement": {
      "description": "The entitlement details",
      "$ref": "#/definitions/Entitlement"
    },
    "CreatedAt": {
      "description": "The timestamp when the entitlement was created",
      "type": "string"
    }
  },
  "required": [
    "ApplicationArn",
    "Entitlement"
  ],
  "readOnlyProperties": [
    "/properties/EntitlementId",
    "/properties/Entitlement/PrincipalRole/Account",
    "/properties/CreatedAt"
  ],
  "createOnlyProperties": [
    "/properties/ApplicationArn",
    "/properties/Entitlement"
  ],
  "primaryIdentifier": [
    "/properties/ApplicationArn",
    "/properties/EntitlementId"
  ],
  "additionalProperties": false,
  "handlers": {
    "create": {
      "permissions": [
        "account-access:CreateEntitlement",
        "account-access:GetEntitlement",
        "account-access:ListEntitlements"
      ]
    },
    "read": {
      "permissions": [
        "account-access:GetEntitlement"
      ]
    },
    "delete": {
      "permissions": [
        "account-access:DeleteEntitlement",
        "account-access:GetEntitlement"
      ]
    },
    "list": {
      "handlerSchema": {
        "properties": {
          "ApplicationArn": {
            "$ref": "resource-schema.json#/properties/ApplicationArn"
          }
        },
        "required": [
          "ApplicationArn"
        ]
      },
      "permissions": [
        "account-access:ListEntitlements"
      ]
    }
  },
  "tagging": {
    "taggable": false
  }
}
