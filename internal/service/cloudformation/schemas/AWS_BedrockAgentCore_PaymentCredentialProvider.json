{
  "typeName": "AWS::BedrockAgentCore::PaymentCredentialProvider",
  "description": "Resource Type definition for AWS::BedrockAgentCore::PaymentCredentialProvider",
  "resourceLink": {
    "templateUri": "/bedrock-agentcore/identity/payment/${Name}?region=${awsRegion}",
    "mappings": {
      "Name": "/Name"
    }
  },
  "definitions": {
    "Tag": {
      "type": "object",
      "properties": {
        "Key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9\\s._:/=+@-]*$"
        },
        "Value": {
          "type": "string",
          "minLength": 0,
          "maxLength": 256,
          "pattern": "^[a-zA-Z0-9\\s._:/=+@-]*$"
        }
      },
      "required": [
        "Key",
        "Value"
      ],
      "additionalProperties": false
    },
    "PaymentProviderConfigurationInput": {
      "type": "object",
      "description": "Provider configuration input containing secrets for creation/update",
      "properties": {
        "CoinbaseCdpConfiguration": {
          "$ref": "#/definitions/CoinbaseCdpConfigurationInput"
        },
        "StripePrivyConfiguration": {
          "$ref": "#/definitions/StripePrivyConfigurationInput"
        },
        "StripeConfiguration": {
          "$ref": "#/definitions/StripeConfigurationInput"
        },
        "PayPalConfiguration": {
          "$ref": "#/definitions/PayPalConfigurationInput"
        },
        "AmazonPayConfiguration": {
          "$ref": "#/definitions/AmazonPayConfigurationInput"
        }
      },
      "additionalProperties": false
    },
    "CoinbaseCdpConfigurationInput": {
      "type": "object",
      "description": "Coinbase CDP configuration with API credentials",
      "properties": {
        "ApiKeyId": {
          "type": "string",
          "description": "The Coinbase CDP API key ID",
          "minLength": 1,
          "maxLength": 512
        },
        "ApiKeySecret": {
          "type": "string",
          "description": "The Coinbase CDP API key secret",
          "minLength": 1,
          "maxLength": 2048
        },
        "ApiKeySecretSource": {
          "$ref": "#/definitions/SecretSourceType"
        },
        "ApiKeySecretConfig": {
          "$ref": "#/definitions/SecretReference"
        },
        "WalletSecret": {
          "type": "string",
          "description": "The Coinbase CDP wallet secret",
          "minLength": 1,
          "maxLength": 2048
        },
        "WalletSecretSource": {
          "$ref": "#/definitions/SecretSourceType"
        },
        "WalletSecretConfig": {
          "$ref": "#/definitions/SecretReference"
        }
      },
      "required": [
        "ApiKeyId"
      ],
      "additionalProperties": false
    },
    "PaymentProviderConfigurationOutput": {
      "type": "object",
      "description": "Provider configuration output containing secret ARNs (no raw secrets)",
      "properties": {
        "CoinbaseCdpConfiguration": {
          "$ref": "#/definitions/CoinbaseCdpConfigurationOutput"
        },
        "StripePrivyConfiguration": {
          "$ref": "#/definitions/StripePrivyConfigurationOutput"
        },
        "StripeConfiguration": {
          "$ref": "#/definitions/StripeConfigurationOutput"
        },
        "PayPalConfiguration": {
          "$ref": "#/definitions/PayPalConfigurationOutput"
        },
        "AmazonPayConfiguration": {
          "$ref": "#/definitions/AmazonPayConfigurationOutput"
        }
      },
      "additionalProperties": false
    },
    "CoinbaseCdpConfigurationOutput": {
      "type": "object",
      "description": "Coinbase CDP configuration output with secret ARNs",
      "properties": {
        "ApiKeyId": {
          "type": "string",
          "description": "The Coinbase CDP API key ID",
          "minLength": 1,
          "maxLength": 512
        },
        "ApiKeySecretArn": {
          "$ref": "#/definitions/SecretInfo"
        },
        "ApiKeySecretJsonKey": {
          "type": "string",
          "description": "The JSON key within the secret that contains the API key secret value",
          "minLength": 1,
          "maxLength": 128
        },
        "ApiKeySecretSource": {
          "$ref": "#/definitions/SecretSourceType"
        },
        "WalletSecretArn": {
          "$ref": "#/definitions/SecretInfo"
        },
        "WalletSecretJsonKey": {
          "type": "string",
          "description": "The JSON key within the secret that contains the wallet secret value",
          "minLength": 1,
          "maxLength": 128
        },
        "WalletSecretSource": {
          "$ref": "#/definitions/SecretSourceType"
        }
      },
      "required": [
        "ApiKeyId",
        "ApiKeySecretArn"
      ],
      "additionalProperties": false
    },
    "SecretInfo": {
      "type": "object",
      "description": "Contains information about a secret in AWS Secrets Manager",
      "properties": {
        "SecretArn": {
          "type": "string",
          "description": "The ARN of the secret in AWS Secrets Manager",
          "pattern": "^arn:(aws|aws-us-gov|aws-cn|aws-iso|aws-iso-b|aws-iso-e|aws-iso-f|aws-eusc):secretsmanager:[A-Za-z0-9-]{1,64}:[0-9]{12}:secret:[a-zA-Z0-9-_/+=.@!]+$"
        }
      },
      "required": [
        "SecretArn"
      ],
      "additionalProperties": false
    },
    "SecretReference": {
      "type": "object",
      "description": "A reference to a customer-provided secret stored in AWS Secrets Manager",
      "properties": {
        "SecretId": {
          "type": "string",
          "description": "The ID or ARN of the secret in AWS Secrets Manager",
          "minLength": 1,
          "maxLength": 2048
        },
        "JsonKey": {
          "type": "string",
          "description": "The JSON key within the secret that contains the credential value",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "SecretId",
        "JsonKey"
      ],
      "additionalProperties": false
    },
    "SecretSourceType": {
      "type": "string",
      "description": "The source of the secret. Use MANAGED for service-managed secrets or EXTERNAL for customer-provided secrets.",
      "enum": [
        "MANAGED",
        "EXTERNAL"
      ]
    },
    "StripePrivyConfigurationInput": {
      "type": "object",
      "description": "Stripe Privy configuration with credentials",
      "properties": {
        "AppId": {
          "type": "string",
          "description": "The app ID provided by Privy",
          "minLength": 1,
          "maxLength": 512
        },
        "AppSecret": {
          "type": "string",
          "description": "The app secret provided by Privy",
          "minLength": 1,
          "maxLength": 2048
        },
        "AppSecretSource": {
          "$ref": "#/definitions/SecretSourceType"
        },
        "AppSecretConfig": {
          "$ref": "#/definitions/SecretReference"
        },
        "AuthorizationPrivateKey": {
          "type": "string",
          "description": "The authorization private key for the Stripe Privy integration",
          "minLength": 1,
          "maxLength": 4096
        },
        "AuthorizationPrivateKeySource": {
          "$ref": "#/definitions/SecretSourceType"
        },
        "AuthorizationPrivateKeyConfig": {
          "$ref": "#/definitions/SecretReference"
        },
        "AuthorizationId": {
          "type": "string",
          "description": "The authorization ID for the Stripe Privy integration",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "required": [
        "AppId",
        "AuthorizationId"
      ],
      "additionalProperties": false
    },
    "StripePrivyConfigurationOutput": {
      "type": "object",
      "description": "Stripe Privy configuration output with secret ARNs",
      "properties": {
        "AppId": {
          "type": "string",
          "description": "The app ID provided by Privy",
          "minLength": 1,
          "maxLength": 512
        },
        "AppSecretArn": {
          "$ref": "#/definitions/SecretInfo"
        },
        "AppSecretJsonKey": {
          "type": "string",
          "description": "The JSON key within the secret that contains the app secret value",
          "minLength": 1,
          "maxLength": 128
        },
        "AppSecretSource": {
          "$ref": "#/definitions/SecretSourceType"
        },
        "AuthorizationPrivateKeyArn": {
          "$ref": "#/definitions/SecretInfo"
        },
        "AuthorizationPrivateKeyJsonKey": {
          "type": "string",
          "description": "The JSON key within the secret that contains the authorization private key value",
          "minLength": 1,
          "maxLength": 128
        },
        "AuthorizationPrivateKeySource": {
          "$ref": "#/definitions/SecretSourceType"
        },
        "AuthorizationId": {
          "type": "string",
          "description": "The authorization ID for the Stripe Privy integration",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "required": [
        "AppId",
        "AppSecretArn",
        "AuthorizationPrivateKeyArn",
        "AuthorizationId"
      ],
      "additionalProperties": false
    },
    "PaymentCredentialProviderVendorType": {
      "type": "string",
      "description": "Supported vendor types for payment providers",
      "enum": [
        "CoinbaseCDP",
        "StripePrivy",
        "Stripe",
        "PayPal",
        "AmazonPay"
      ]
    },
    "StripeConfigurationInput": {
      "type": "object",
      "description": "Stripe configuration with a restricted key, supplied inline (MANAGED) or as a Secrets Manager reference (EXTERNAL)",
      "properties": {
        "RestrictedKey": {
          "type": "string",
          "description": "The Stripe restricted key (rk_live_* or rk_test_*), supplied inline. Mutually exclusive with RestrictedKeyConfig.",
          "maxLength": 512,
          "pattern": "^[a-zA-Z0-9_]*$"
        },
        "RestrictedKeySource": {
          "$ref": "#/definitions/SecretSourceType"
        },
        "RestrictedKeyConfig": {
          "$ref": "#/definitions/SecretReference"
        },
        "PublishableKey": {
          "type": "string",
          "description": "The Stripe publishable key (pk_live_* or pk_test_*). Its mode must match the restricted key's.",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^pk_(live|test)_[A-Za-z0-9]+$"
        }
      },
      "additionalProperties": false
    },
    "StripeConfigurationOutput": {
      "type": "object",
      "description": "Stripe configuration output with the restricted key secret ARN",
      "properties": {
        "RestrictedKeyArn": {
          "$ref": "#/definitions/SecretInfo"
        },
        "RestrictedKeyJsonKey": {
          "type": "string",
          "description": "The JSON key within the secret that contains the restricted key value",
          "minLength": 1,
          "maxLength": 128
        },
        "RestrictedKeySource": {
          "$ref": "#/definitions/SecretSourceType"
        },
        "PublishableKey": {
          "type": "string",
          "description": "The Stripe publishable key stored on the provider. Only present when one was supplied.",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^pk_(live|test)_[A-Za-z0-9]+$"
        }
      },
      "required": [
        "RestrictedKeyArn"
      ],
      "additionalProperties": false
    },
    "PayPalConfigurationInput": {
      "type": "object",
      "description": "PayPal configuration with REST app credentials",
      "properties": {
        "ClientId": {
          "type": "string",
          "description": "The PayPal REST app client ID",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "ClientSecret": {
          "type": "string",
          "description": "The PayPal REST app client secret, supplied inline. Mutually exclusive with ClientSecretConfig.",
          "maxLength": 512,
          "pattern": "^[A-Za-z0-9+/=\\-_]*$"
        },
        "ClientSecretSource": {
          "$ref": "#/definitions/SecretSourceType"
        },
        "ClientSecretConfig": {
          "$ref": "#/definitions/SecretReference"
        },
        "Environment": {
          "$ref": "#/definitions/PayPalEnvironmentType"
        }
      },
      "required": [
        "ClientId",
        "Environment"
      ],
      "additionalProperties": false
    },
    "PayPalConfigurationOutput": {
      "type": "object",
      "description": "PayPal configuration output with the client secret ARN",
      "properties": {
        "ClientId": {
          "type": "string",
          "description": "The PayPal REST app client ID",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "ClientSecretArn": {
          "$ref": "#/definitions/SecretInfo"
        },
        "ClientSecretJsonKey": {
          "type": "string",
          "description": "The JSON key within the secret that contains the client secret value",
          "minLength": 1,
          "maxLength": 128
        },
        "ClientSecretSource": {
          "$ref": "#/definitions/SecretSourceType"
        },
        "Environment": {
          "$ref": "#/definitions/PayPalEnvironmentType"
        }
      },
      "required": [
        "ClientId",
        "ClientSecretArn",
        "Environment"
      ],
      "additionalProperties": false
    },
    "PayPalEnvironmentType": {
      "type": "string",
      "description": "The PayPal API environment",
      "enum": [
        "LIVE",
        "SANDBOX"
      ]
    },
    "AmazonPayConfigurationInput": {
      "type": "object",
      "description": "Amazon Pay configuration with merchant identifiers and a delegated authorization token",
      "properties": {
        "MerchantId": {
          "type": "string",
          "description": "The Amazon Pay merchant (seller) ID",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Z0-9]+$"
        },
        "StoreId": {
          "type": "string",
          "description": "The Amazon Pay store (client) ID",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9._-]+$"
        },
        "AuthorizationToken": {
          "type": "string",
          "description": "The delegated authorization token, supplied inline. Mutually exclusive with AuthorizationTokenConfig.",
          "maxLength": 8192,
          "pattern": "^[A-Za-z0-9+/=._\\-]*$"
        },
        "AuthorizationTokenSource": {
          "$ref": "#/definitions/SecretSourceType"
        },
        "AuthorizationTokenConfig": {
          "$ref": "#/definitions/SecretReference"
        },
        "Environment": {
          "$ref": "#/definitions/AmazonPayEnvironmentType"
        },
        "AmazonPayRegion": {
          "$ref": "#/definitions/AmazonPayRegionType"
        }
      },
      "required": [
        "MerchantId",
        "StoreId",
        "Environment",
        "AmazonPayRegion"
      ],
      "additionalProperties": false
    },
    "AmazonPayConfigurationOutput": {
      "type": "object",
      "description": "Amazon Pay configuration output with the authorization token secret ARN",
      "properties": {
        "MerchantId": {
          "type": "string",
          "description": "The Amazon Pay merchant (seller) ID",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Z0-9]+$"
        },
        "StoreId": {
          "type": "string",
          "description": "The Amazon Pay store (client) ID",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9._-]+$"
        },
        "AuthorizationTokenArn": {
          "$ref": "#/definitions/SecretInfo"
        },
        "AuthorizationTokenJsonKey": {
          "type": "string",
          "description": "The JSON key within the secret that contains the authorization token value",
          "minLength": 1,
          "maxLength": 128
        },
        "AuthorizationTokenSource": {
          "$ref": "#/definitions/SecretSourceType"
        },
        "Environment": {
          "$ref": "#/definitions/AmazonPayEnvironmentType"
        },
        "AmazonPayRegion": {
          "$ref": "#/definitions/AmazonPayRegionType"
        }
      },
      "required": [
        "MerchantId",
        "StoreId",
        "AuthorizationTokenArn",
        "Environment"
      ],
      "additionalProperties": false
    },
    "AmazonPayEnvironmentType": {
      "type": "string",
      "description": "The Amazon Pay API environment",
      "enum": [
        "LIVE",
        "SANDBOX"
      ]
    },
    "AmazonPayRegionType": {
      "type": "string",
      "description": "The Amazon Pay region the merchant's authorization token belongs to. AgentCore uses it to pick the Amazon Pay API host.",
      "enum": [
        "NA",
        "EU",
        "JP"
      ]
    }
  },
  "properties": {
    "Name": {
      "type": "string",
      "description": "Unique name for the payment credential provider",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-zA-Z0-9\\-_]+$"
    },
    "CredentialProviderVendor": {
      "$ref": "#/definitions/PaymentCredentialProviderVendorType"
    },
    "ProviderConfigurationInput": {
      "$ref": "#/definitions/PaymentProviderConfigurationInput"
    },
    "CredentialProviderArn": {
      "type": "string",
      "description": "The Amazon Resource Name (ARN) of the payment credential provider",
      "pattern": "^arn:(aws|aws-us-gov|aws-cn|aws-iso|aws-iso-b|aws-iso-e|aws-iso-f|aws-eusc):(acps|bedrock-agentcore):[A-Za-z0-9-]{1,64}:[0-9]{12}:token-vault/[a-zA-Z0-9-.]+/paymentcredentialprovider/[a-zA-Z0-9_.-]+$"
    },
    "ProviderConfigurationOutput": {
      "$ref": "#/definitions/PaymentProviderConfigurationOutput"
    },
    "CreatedTime": {
      "type": "string",
      "format": "date-time",
      "description": "The timestamp when the credential provider was created"
    },
    "LastUpdatedTime": {
      "type": "string",
      "format": "date-time",
      "description": "The timestamp when the credential provider was last updated"
    },
    "Tags": {
      "type": "array",
      "description": "Tags for the payment credential provider",
      "items": {
        "$ref": "#/definitions/Tag"
      },
      "maxItems": 50,
      "insertionOrder": false
    }
  },
  "additionalProperties": false,
  "required": [
    "Name",
    "CredentialProviderVendor"
  ],
  "readOnlyProperties": [
    "/properties/CredentialProviderArn",
    "/properties/ProviderConfigurationOutput",
    "/properties/CreatedTime",
    "/properties/LastUpdatedTime"
  ],
  "writeOnlyProperties": [
    "/properties/ProviderConfigurationInput"
  ],
  "createOnlyProperties": [
    "/properties/Name",
    "/properties/CredentialProviderVendor",
    "/properties/ProviderConfigurationInput/AmazonPayConfiguration/MerchantId",
    "/properties/ProviderConfigurationInput/AmazonPayConfiguration/AmazonPayRegion",
    "/properties/ProviderConfigurationInput/AmazonPayConfiguration/AuthorizationTokenSource"
  ],
  "primaryIdentifier": [
    "/properties/CredentialProviderArn"
  ],
  "tagging": {
    "taggable": true,
    "tagOnCreate": true,
    "tagUpdatable": true,
    "tagProperty": "/properties/Tags",
    "cloudFormationSystemTags": true,
    "permissions": [
      "bedrock-agentcore:TagResource",
      "bedrock-agentcore:UntagResource",
      "bedrock-agentcore:ListTagsForResource"
    ]
  },
  "handlers": {
    "create": {
      "permissions": [
        "bedrock-agentcore:CreatePaymentCredentialProvider",
        "bedrock-agentcore:GetPaymentCredentialProvider",
        "bedrock-agentcore:CreateTokenVault",
        "bedrock-agentcore:TagResource",
        "secretsmanager:CreateSecret",
        "secretsmanager:DescribeSecret",
        "secretsmanager:GetSecretValue"
      ]
    },
    "read": {
      "permissions": [
        "bedrock-agentcore:GetPaymentCredentialProvider",
        "bedrock-agentcore:ListTagsForResource"
      ]
    },
    "update": {
      "permissions": [
        "bedrock-agentcore:UpdatePaymentCredentialProvider",
        "bedrock-agentcore:GetPaymentCredentialProvider",
        "bedrock-agentcore:TagResource",
        "bedrock-agentcore:UntagResource",
        "bedrock-agentcore:ListTagsForResource",
        "secretsmanager:PutSecretValue",
        "secretsmanager:DescribeSecret",
        "secretsmanager:GetSecretValue"
      ]
    },
    "delete": {
      "permissions": [
        "bedrock-agentcore:DeletePaymentCredentialProvider",
        "bedrock-agentcore:GetPaymentCredentialProvider",
        "bedrock-agentcore:ListTagsForResource",
        "secretsmanager:DeleteSecret"
      ]
    },
    "list": {
      "permissions": [
        "bedrock-agentcore:ListPaymentCredentialProviders"
      ]
    }
  }
}
