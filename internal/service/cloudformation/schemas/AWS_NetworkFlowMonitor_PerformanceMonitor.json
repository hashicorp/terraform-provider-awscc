{
  "typeName": "AWS::NetworkFlowMonitor::PerformanceMonitor",
  "description": "Creates a performance monitor to monitor network performance between a set of targets for a workload.",
  "definitions": {
    "PerformanceMonitorTarget": {
      "type": "object",
      "description": "A target that is monitored by a performance monitor.",
      "properties": {
        "Type": {
          "type": "string",
          "description": "The type of the target.",
          "enum": [
            "AWS::EC2::VPC"
          ]
        },
        "Identifier": {
          "type": "string",
          "description": "The identifier of the target.",
          "minLength": 20,
          "maxLength": 128,
          "pattern": "^arn:.*$"
        }
      },
      "required": [
        "Type",
        "Identifier"
      ],
      "additionalProperties": false
    },
    "Tag": {
      "type": "object",
      "properties": {
        "Key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "Value": {
          "type": "string",
          "minLength": 0,
          "maxLength": 256
        }
      },
      "required": [
        "Key",
        "Value"
      ],
      "additionalProperties": false
    }
  },
  "properties": {
    "Arn": {
      "type": "string",
      "description": "The Amazon Resource Name (ARN) of the performance monitor.",
      "minLength": 20,
      "maxLength": 512,
      "pattern": "^arn:.*$"
    },
    "MonitorName": {
      "type": "string",
      "description": "The name of the performance monitor.",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^[a-zA-Z0-9_.-]+$"
    },
    "ScopeArn": {
      "type": "string",
      "description": "The Amazon Resource Name (ARN) of the scope for the performance monitor.",
      "minLength": 20,
      "maxLength": 2048,
      "pattern": "^arn:.*$"
    },
    "Targets": {
      "type": "array",
      "description": "The targets that are monitored by the performance monitor.",
      "items": {
        "$ref": "#/definitions/PerformanceMonitorTarget"
      },
      "minItems": 1,
      "maxItems": 100,
      "insertionOrder": false
    },
    "MonitorType": {
      "type": "string",
      "description": "The type of the performance monitor.",
      "enum": [
        "VPC"
      ]
    },
    "MonitorStatus": {
      "type": "string",
      "description": "The status of the performance monitor.",
      "enum": [
        "PENDING",
        "ACTIVE",
        "INACTIVE",
        "ERROR",
        "DELETING"
      ]
    },
    "CreatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "The date and time when the performance monitor was created."
    },
    "ModifiedAt": {
      "type": "string",
      "format": "date-time",
      "description": "The date and time when the performance monitor was last modified."
    },
    "Tags": {
      "type": "array",
      "description": "The tags for the performance monitor.",
      "items": {
        "$ref": "#/definitions/Tag"
      },
      "maxItems": 200,
      "insertionOrder": false
    }
  },
  "required": [
    "MonitorName",
    "Targets"
  ],
  "readOnlyProperties": [
    "/properties/Arn",
    "/properties/MonitorType",
    "/properties/MonitorStatus",
    "/properties/CreatedAt",
    "/properties/ModifiedAt"
  ],
  "writeOnlyProperties": [
    "/properties/ScopeArn"
  ],
  "createOnlyProperties": [
    "/properties/MonitorName",
    "/properties/ScopeArn"
  ],
  "primaryIdentifier": [
    "/properties/Arn"
  ],
  "additionalIdentifiers": [
    [
      "/properties/MonitorName"
    ]
  ],
  "tagging": {
    "taggable": true,
    "tagOnCreate": true,
    "tagUpdatable": true,
    "cloudFormationSystemTags": true,
    "tagProperty": "/properties/Tags",
    "permissions": [
      "networkflowmonitor:TagResource",
      "networkflowmonitor:UntagResource",
      "networkflowmonitor:ListTagsForResource"
    ]
  },
  "handlers": {
    "create": {
      "permissions": [
        "networkflowmonitor:CreatePerformanceMonitor",
        "networkflowmonitor:GetPerformanceMonitor",
        "networkflowmonitor:TagResource"
      ]
    },
    "read": {
      "permissions": [
        "networkflowmonitor:GetPerformanceMonitor",
        "networkflowmonitor:ListTagsForResource"
      ]
    },
    "update": {
      "permissions": [
        "networkflowmonitor:UpdatePerformanceMonitor",
        "networkflowmonitor:GetPerformanceMonitor",
        "networkflowmonitor:TagResource",
        "networkflowmonitor:UntagResource",
        "networkflowmonitor:ListTagsForResource"
      ]
    },
    "delete": {
      "permissions": [
        "networkflowmonitor:DeletePerformanceMonitor",
        "networkflowmonitor:GetPerformanceMonitor"
      ]
    },
    "list": {
      "permissions": [
        "networkflowmonitor:ListPerformanceMonitors"
      ]
    }
  },
  "additionalProperties": false
}
