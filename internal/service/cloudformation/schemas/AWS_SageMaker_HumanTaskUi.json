{
  "typeName": "AWS::SageMaker::HumanTaskUi",
  "description": "Resource Type definition for AWS::SageMaker::HumanTaskUi",
  "properties": {
    "HumanTaskUiArn": {
      "type": "string",
      "description": "The Amazon Resource Name (ARN) of the human task user interface.",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^arn:aws[a-z\\-]*:sagemaker:[a-z0-9\\-]+:[0-9]{12}:human-task-ui/"
    },
    "HumanTaskUiName": {
      "type": "string",
      "description": "The name of the human task user interface.",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[a-z0-9](-*[a-z0-9])*$"
    },
    "UiTemplate": {
      "description": "The Liquid template for the worker user interface.",
      "$ref": "#/definitions/UiTemplate"
    },
    "CreationTime": {
      "type": "string",
      "format": "date-time",
      "description": "The timestamp when the human task user interface was created."
    },
    "Tags": {
      "type": "array",
      "description": "An array of key-value pairs that contain metadata to help you categorize and organize a human review workflow user interface.",
      "maxItems": 50,
      "items": {
        "$ref": "#/definitions/Tag"
      },
      "insertionOrder": false
    }
  },
  "definitions": {
    "UiTemplate": {
      "type": "object",
      "description": "The Liquid template for the worker user interface.",
      "properties": {
        "Content": {
          "type": "string",
          "description": "The content of the Liquid template for the worker user interface.",
          "minLength": 1,
          "maxLength": 128000
        }
      },
      "required": [
        "Content"
      ],
      "additionalProperties": false
    },
    "Tag": {
      "type": "object",
      "properties": {
        "Key": {
          "type": "string",
          "description": "The tag key.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^([\\p{L}\\p{Z}\\p{N}_.:/=+\\-@]*)$"
        },
        "Value": {
          "type": "string",
          "description": "The tag value.",
          "minLength": 0,
          "maxLength": 256,
          "pattern": "^([\\p{L}\\p{Z}\\p{N}_.:/=+\\-@]*)$"
        }
      },
      "required": [
        "Key",
        "Value"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "HumanTaskUiName"
  ],
  "additionalProperties": false,
  "readOnlyProperties": [
    "/properties/HumanTaskUiArn",
    "/properties/CreationTime"
  ],
  "createOnlyProperties": [
    "/properties/HumanTaskUiName",
    "/properties/UiTemplate"
  ],
  "writeOnlyProperties": [
    "/properties/UiTemplate"
  ],
  "primaryIdentifier": [
    "/properties/HumanTaskUiArn"
  ],
  "additionalIdentifiers": [
    [
      "/properties/HumanTaskUiName"
    ]
  ],
  "tagging": {
    "taggable": true,
    "tagOnCreate": true,
    "tagUpdatable": true,
    "cloudFormationSystemTags": false,
    "tagProperty": "/properties/Tags",
    "permissions": [
      "sagemaker:AddTags",
      "sagemaker:DeleteTags",
      "sagemaker:ListTags"
    ]
  },
  "handlers": {
    "create": {
      "permissions": [
        "sagemaker:CreateHumanTaskUi",
        "sagemaker:DescribeHumanTaskUi",
        "sagemaker:AddTags",
        "sagemaker:ListTags"
      ]
    },
    "read": {
      "permissions": [
        "sagemaker:DescribeHumanTaskUi",
        "sagemaker:ListTags"
      ]
    },
    "update": {
      "permissions": [
        "sagemaker:DescribeHumanTaskUi",
        "sagemaker:AddTags",
        "sagemaker:DeleteTags",
        "sagemaker:ListTags"
      ]
    },
    "delete": {
      "permissions": [
        "sagemaker:DeleteHumanTaskUi",
        "sagemaker:DescribeHumanTaskUi",
        "sagemaker:ListTags"
      ]
    },
    "list": {
      "permissions": [
        "sagemaker:ListHumanTaskUis"
      ]
    }
  }
}
