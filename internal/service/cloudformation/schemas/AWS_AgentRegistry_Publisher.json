{
  "typeName": "AWS::AgentRegistry::Publisher",
  "description": "Definition of AWS::AgentRegistry::Publisher Resource Type. A Publisher is a domain that an AWS account proves ownership of. While creation is in progress, retrieve the DNS challenge through the Agent Registry ListPublishers and GetPublisher APIs. The resource reaches CREATE_COMPLETE after the domain is verified and the Publisher status is ACTIVE.",
  "definitions": {
    "Identifier": {
      "type": "object",
      "description": "The identifier value. Exactly one member is set.",
      "properties": {
        "Domain": {
          "type": "string",
          "description": "The fully qualified domain name (RFC 1035/1123) with at least two labels, in lowercase. The service stores domain names in lowercase, so specify the value in lowercase to avoid drift.",
          "minLength": 1,
          "maxLength": 253,
          "pattern": "^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]{2,63}$"
        }
      },
      "required": [
        "Domain"
      ],
      "additionalProperties": false
    },
    "VerificationStatus": {
      "type": "string",
      "description": "The verification status of the Publisher.",
      "enum": [
        "ACTION_REQUIRED",
        "ACTIVE",
        "FAILED",
        "SUSPENDED",
        "DELETING"
      ]
    },
    "Tag": {
      "type": "object",
      "description": "A tag to assign to the Publisher.",
      "properties": {
        "Key": {
          "type": "string",
          "description": "The key of the tag.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9\\s._:/=+@-]*$"
        },
        "Value": {
          "type": "string",
          "description": "The value of the tag.",
          "minLength": 0,
          "maxLength": 256,
          "pattern": "^[a-zA-Z0-9\\s._:/=+@-]*$"
        }
      },
      "required": [
        "Key",
        "Value"
      ],
      "additionalProperties": false
    }
  },
  "properties": {
    "Value": {
      "$ref": "#/definitions/Identifier",
      "description": "The identifier that this Publisher proves ownership of."
    },
    "PublisherArn": {
      "type": "string",
      "description": "The Amazon Resource Name (ARN) of the Publisher. The Publisher is a global resource, so the ARN has no Region.",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^arn:(aws|aws-cn|aws-us-gov):agent-registry::[0-9]{12}:publisher/.+$"
    },
    "Status": {
      "$ref": "#/definitions/VerificationStatus",
      "description": "The verification status of the Publisher."
    },
    "CreatedAt": {
      "type": "string",
      "description": "The timestamp when the Publisher was created.",
      "format": "date-time"
    },
    "UpdatedAt": {
      "type": "string",
      "description": "The timestamp when the Publisher was last updated.",
      "format": "date-time"
    },
    "Tags": {
      "type": "array",
      "description": "Tags to assign to the Publisher.",
      "items": {
        "$ref": "#/definitions/Tag"
      },
      "maxItems": 50,
      "uniqueItems": true,
      "insertionOrder": false
    }
  },
  "required": [
    "Value"
  ],
  "readOnlyProperties": [
    "/properties/PublisherArn",
    "/properties/Status",
    "/properties/CreatedAt",
    "/properties/UpdatedAt"
  ],
  "createOnlyProperties": [
    "/properties/Value"
  ],
  "primaryIdentifier": [
    "/properties/PublisherArn"
  ],
  "additionalProperties": false,
  "tagging": {
    "taggable": true,
    "tagOnCreate": true,
    "tagUpdatable": true,
    "cloudFormationSystemTags": true,
    "tagProperty": "/properties/Tags",
    "permissions": [
      "agent-registry:TagResource",
      "agent-registry:UntagResource",
      "agent-registry:ListTagsForResource"
    ]
  },
  "handlers": {
    "create": {
      "timeoutInMinutes": 2160,
      "permissions": [
        "agent-registry:CreatePublisher",
        "agent-registry:GetPublisher",
        "agent-registry:TagResource",
        "agent-registry:ListTagsForResource"
      ]
    },
    "read": {
      "permissions": [
        "agent-registry:GetPublisher",
        "agent-registry:ListTagsForResource"
      ]
    },
    "update": {
      "permissions": [
        "agent-registry:TagResource",
        "agent-registry:UntagResource",
        "agent-registry:GetPublisher",
        "agent-registry:ListTagsForResource"
      ]
    },
    "delete": {
      "permissions": [
        "agent-registry:DeletePublisher",
        "agent-registry:GetPublisher"
      ]
    },
    "list": {
      "permissions": [
        "agent-registry:ListPublishers"
      ]
    }
  }
}
