{
  "tagging": {
    "taggable": false,
    "tagOnCreate": false,
    "tagUpdatable": false,
    "cloudFormationSystemTags": false
  },
  "typeName": "AWS::ECS::GatewayClusterAssociations",
  "readOnlyProperties": [
    "/properties/GatewayArn",
    "/properties/ClusterArn",
    "/properties/Status"
  ],
  "description": "Resource Type definition for AWS::ECS::GatewayClusterAssociations, which associates an ECS Gateway with an ECS Cluster.",
  "createOnlyProperties": [
    "/properties/Gateway",
    "/properties/Cluster"
  ],
  "primaryIdentifier": [
    "/properties/Gateway",
    "/properties/Cluster"
  ],
  "required": [
    "Gateway",
    "Cluster"
  ],
  "sourceUrl": "https://github.com/aws-cloudformation/aws-cloudformation-rpdk.git",
  "handlers": {
    "read": {
      "permissions": [
        "ecs:ListGatewayClusterAssociations"
      ]
    },
    "create": {
      "permissions": [
        "ecs:AssociateGatewayWithCluster",
        "ecs:ListGatewayClusterAssociations"
      ]
    },
    "list": {
      "permissions": [
        "ecs:ListGatewayClusterAssociations"
      ]
    },
    "delete": {
      "permissions": [
        "ecs:DisassociateGatewayFromCluster",
        "ecs:ListGatewayClusterAssociations"
      ]
    }
  },
  "additionalProperties": false,
  "definitions": {
    "GatewayClusterAssociationStatus": {
      "description": "The status of the association between the gateway and the cluster.",
      "type": "string",
      "enum": [
        "ACTIVE",
        "DISASSOCIATING"
      ]
    }
  },
  "properties": {
    "GatewayArn": {
      "pattern": "^arn:aws[a-zA-Z-]*:ecs:[a-z0-9-]+:[0-9]{12}:gateway/.+$",
      "description": "The full Amazon Resource Name (ARN) of the associated gateway.",
      "type": "string"
    },
    "ClusterArn": {
      "pattern": "^arn:aws[a-zA-Z-]*:ecs:[a-z0-9-]+:[0-9]{12}:cluster/.+$",
      "description": "The full Amazon Resource Name (ARN) of the associated cluster.",
      "type": "string"
    },
    "Status": {
      "description": "The status of the association.",
      "$ref": "#/definitions/GatewayClusterAssociationStatus"
    },
    "Gateway": {
      "description": "The name or full Amazon Resource Name (ARN) of the gateway to associate with the cluster.",
      "type": "string"
    },
    "Cluster": {
      "description": "The name or full Amazon Resource Name (ARN) of the cluster to associate the gateway with.",
      "type": "string"
    }
  }
}
