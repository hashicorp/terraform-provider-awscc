{
  "typeName": "AWS::EC2::FpgaImage",
  "description": "Creates and manages an Amazon FPGA Image (AFI) from a design checkpoint (DCP).",
  "properties": {
    "Arn": {
      "type": "string",
      "description": "The ARN of the FPGA image."
    },
    "FpgaImageId": {
      "type": "string",
      "description": "The FPGA image identifier (AFI ID)."
    },
    "FpgaImageGlobalId": {
      "type": "string",
      "description": "The global FPGA image identifier (AGFI ID)."
    },
    "Name": {
      "type": "string",
      "description": "A name for the AFI."
    },
    "Description": {
      "type": "string",
      "description": "A description for the AFI."
    },
    "InputStorageLocation": {
      "description": "The location of the encrypted design checkpoint in Amazon S3. The input must be a tarball.",
      "$ref": "#/definitions/StorageLocation"
    },
    "LogsStorageLocation": {
      "description": "The location in Amazon S3 for the output logs.",
      "$ref": "#/definitions/StorageLocation"
    },
    "State": {
      "type": "string",
      "description": "The state of the AFI (pending | available | failed | unavailable)."
    },
    "OwnerId": {
      "type": "string",
      "description": "The ID of the AWS account that owns the AFI."
    },
    "CreateTime": {
      "type": "string",
      "format": "date-time",
      "description": "The date and time the AFI was created."
    },
    "UpdateTime": {
      "type": "string",
      "format": "date-time",
      "description": "The time of the most recent update to the AFI."
    },
    "DataRetentionSupport": {
      "type": "boolean",
      "description": "Indicates whether data retention support is enabled for the AFI."
    },
    "Public": {
      "type": "boolean",
      "description": "Indicates whether the AFI is public."
    },
    "Tags": {
      "type": "array",
      "description": "The tags assigned to the FPGA image.",
      "items": {
        "$ref": "#/definitions/Tag"
      }
    }
  },
  "definitions": {
    "StorageLocation": {
      "type": "object",
      "description": "Describes a storage location in Amazon S3.",
      "properties": {
        "Bucket": {
          "type": "string",
          "description": "The name of the S3 bucket."
        },
        "Key": {
          "type": "string",
          "description": "The key."
        }
      },
      "additionalProperties": false
    },
    "Tag": {
      "type": "object",
      "description": "A tag consisting of a key-value pair.",
      "properties": {
        "Key": {
          "type": "string",
          "description": "The tag key."
        },
        "Value": {
          "type": "string",
          "description": "The tag value."
        }
      },
      "required": [
        "Key",
        "Value"
      ],
      "additionalProperties": false
    }
  },
  "required": [],
  "writeOnlyProperties": [
    "/properties/InputStorageLocation",
    "/properties/LogsStorageLocation"
  ],
  "createOnlyProperties": [
    "/properties/InputStorageLocation",
    "/properties/LogsStorageLocation"
  ],
  "readOnlyProperties": [
    "/properties/Arn",
    "/properties/FpgaImageId",
    "/properties/FpgaImageGlobalId",
    "/properties/State",
    "/properties/OwnerId",
    "/properties/CreateTime",
    "/properties/UpdateTime",
    "/properties/DataRetentionSupport",
    "/properties/Public"
  ],
  "primaryIdentifier": [
    "/properties/Arn"
  ],
  "additionalIdentifiers": [
    [
      "/properties/FpgaImageId"
    ]
  ],
  "additionalProperties": false,
  "tagging": {
    "taggable": true,
    "tagOnCreate": true,
    "tagUpdatable": true,
    "cloudFormationSystemTags": false,
    "tagProperty": "/properties/Tags",
    "permissions": [
      "ec2:CreateTags",
      "ec2:DeleteTags",
      "ec2:DescribeTags"
    ]
  },
  "handlers": {
    "create": {
      "permissions": [
        "ec2:CreateFpgaImage",
        "ec2:DescribeFpgaImages",
        "ec2:CreateTags",
        "s3:GetObject"
      ]
    },
    "read": {
      "permissions": [
        "ec2:DescribeFpgaImages",
        "ec2:DescribeTags"
      ]
    },
    "update": {
      "permissions": [
        "ec2:ModifyFpgaImageAttribute",
        "ec2:DescribeFpgaImages",
        "ec2:CreateTags",
        "ec2:DeleteTags",
        "ec2:DescribeTags"
      ]
    },
    "delete": {
      "permissions": [
        "ec2:DeleteFpgaImage",
        "ec2:DescribeFpgaImages",
        "ec2:DeleteTags",
        "ec2:DescribeTags"
      ]
    },
    "list": {
      "permissions": [
        "ec2:DescribeFpgaImages"
      ]
    }
  }
}
