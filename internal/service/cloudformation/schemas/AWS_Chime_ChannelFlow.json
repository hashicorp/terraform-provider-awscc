{
  "typeName": "AWS::Chime::ChannelFlow",
  "description": "Creates a channel flow in the Amazon Chime SDK Messaging service. A channel flow is a container for processors (Lambda functions) that perform actions on chat messages.",
  "properties": {
    "Arn": {
      "type": "string",
      "description": "The ARN of the channel flow.",
      "minLength": 5,
      "maxLength": 1600,
      "pattern": ""
    },
    "AppInstanceArn": {
      "type": "string",
      "description": "The ARN of the app instance.",
      "minLength": 5,
      "maxLength": 1600,
      "pattern": ""
    },
    "AppInstanceId": {
      "type": "string",
      "description": "The ID of the app instance, extracted from the channel flow ARN."
    },
    "ChannelFlowId": {
      "type": "string",
      "description": "The ID of the channel flow, extracted from the channel flow ARN."
    },
    "Name": {
      "type": "string",
      "description": "The name of the channel flow.",
      "minLength": 1,
      "maxLength": 256
    },
    "Processors": {
      "type": "array",
      "description": "Information about the processor Lambda functions.",
      "items": {
        "$ref": "#/definitions/Processor"
      },
      "minItems": 1,
      "maxItems": 3,
      "insertionOrder": true
    },
    "Tags": {
      "type": "array",
      "description": "The tags for the channel flow.",
      "items": {
        "$ref": "#/definitions/Tag"
      },
      "maxItems": 50,
      "insertionOrder": false
    },
    "CreatedTimestamp": {
      "type": "string",
      "description": "The time at which the channel flow was created.",
      "format": "date-time"
    },
    "LastUpdatedTimestamp": {
      "type": "string",
      "description": "The time at which the channel flow was last updated.",
      "format": "date-time"
    }
  },
  "definitions": {
    "Processor": {
      "type": "object",
      "description": "Information about a processor in a channel flow.",
      "properties": {
        "Name": {
          "type": "string",
          "description": "The name of the processor.",
          "minLength": 1,
          "maxLength": 256
        },
        "Configuration": {
          "$ref": "#/definitions/ProcessorConfiguration"
        },
        "ExecutionOrder": {
          "type": "integer",
          "description": "The sequence in which processors run.",
          "minimum": 1,
          "maximum": 3
        },
        "FallbackAction": {
          "type": "string",
          "description": "Determines whether to continue or stop processing when communication with a processor fails.",
          "enum": [
            "CONTINUE",
            "ABORT"
          ]
        }
      },
      "required": [
        "Name",
        "Configuration",
        "ExecutionOrder",
        "FallbackAction"
      ],
      "additionalProperties": false
    },
    "ProcessorConfiguration": {
      "type": "object",
      "description": "A processor's metadata.",
      "properties": {
        "Lambda": {
          "$ref": "#/definitions/LambdaConfiguration"
        }
      },
      "required": [
        "Lambda"
      ],
      "additionalProperties": false
    },
    "LambdaConfiguration": {
      "type": "object",
      "description": "Stores metadata about a Lambda processor.",
      "properties": {
        "ResourceArn": {
          "type": "string",
          "description": "The ARN of the Lambda message processing function.",
          "minLength": 15,
          "maxLength": 2048,
          "pattern": "^arn:aws:lambda:[a-z]{2}-[a-z]+-\\d{1}:\\d{12}:function:[a-zA-Z0-9\\-_\\.]+(:(\\$LATEST|[a-zA-Z0-9\\-_]+))?$"
        },
        "InvocationType": {
          "type": "string",
          "description": "Controls how the Lambda function is invoked.",
          "enum": [
            "ASYNC"
          ]
        }
      },
      "required": [
        "ResourceArn",
        "InvocationType"
      ],
      "additionalProperties": false
    },
    "Tag": {
      "type": "object",
      "properties": {
        "Key": {
          "type": "string",
          "description": "The key in a tag.",
          "minLength": 1,
          "maxLength": 128
        },
        "Value": {
          "type": "string",
          "description": "The value in a tag.",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "Key",
        "Value"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "AppInstanceArn",
    "Name",
    "Processors"
  ],
  "readOnlyProperties": [
    "/properties/Arn",
    "/properties/AppInstanceId",
    "/properties/ChannelFlowId",
    "/properties/CreatedTimestamp",
    "/properties/LastUpdatedTimestamp"
  ],
  "createOnlyProperties": [
    "/properties/AppInstanceArn"
  ],
  "primaryIdentifier": [
    "/properties/Arn"
  ],
  "additionalIdentifiers": [
    [
      "/properties/AppInstanceId",
      "/properties/ChannelFlowId"
    ]
  ],
  "tagging": {
    "taggable": true,
    "tagOnCreate": true,
    "tagUpdatable": true,
    "cloudFormationSystemTags": false,
    "tagProperty": "/properties/Tags",
    "permissions": [
      "chime:TagResource",
      "chime:UntagResource",
      "chime:ListTagsForResource"
    ]
  },
  "handlers": {
    "create": {
      "permissions": [
        "chime:CreateChannelFlow",
        "chime:DescribeChannelFlow",
        "chime:TagResource"
      ]
    },
    "read": {
      "permissions": [
        "chime:DescribeChannelFlow",
        "chime:ListTagsForResource"
      ]
    },
    "update": {
      "permissions": [
        "chime:UpdateChannelFlow",
        "chime:DescribeChannelFlow",
        "chime:TagResource",
        "chime:UntagResource",
        "chime:ListTagsForResource"
      ]
    },
    "delete": {
      "permissions": [
        "chime:DeleteChannelFlow",
        "chime:DescribeChannelFlow"
      ]
    },
    "list": {
      "permissions": [
        "chime:ListChannelFlows"
      ],
      "handlerSchema": {
        "properties": {
          "AppInstanceArn": {
            "type": "string",
            "description": "The ARN of the app instance.",
            "minLength": 5,
            "maxLength": 1600,
            "pattern": ""
          }
        },
        "required": [
          "AppInstanceArn"
        ]
      }
    }
  },
  "additionalProperties": false
}
