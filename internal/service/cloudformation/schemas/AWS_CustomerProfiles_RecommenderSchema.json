{
  "typeName": "AWS::CustomerProfiles::RecommenderSchema",
  "description": "A recommender schema defining the set of data columns available for training recommenders and filters under an Amazon Connect Customer Profiles domain.",
  "definitions": {
    "RecommenderSchemaField": {
      "type": "object",
      "properties": {
        "TargetFieldName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "ContentType": {
          "type": "string",
          "enum": [
            "STRING",
            "NUMBER"
          ]
        },
        "FeatureType": {
          "type": "string",
          "enum": [
            "TEXTUAL",
            "CATEGORICAL"
          ]
        }
      },
      "required": [
        "TargetFieldName"
      ],
      "additionalProperties": false
    }
  },
  "properties": {
    "Arn": {
      "type": "string",
      "pattern": "^arn:([a-z\\d-]+):profile:.*:.*:.+$"
    },
    "DomainName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-zA-Z0-9_-]+$"
    },
    "RecommenderSchemaName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-zA-Z0-9_-]+$"
    },
    "Fields": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 2,
      "patternProperties": {
        "": {
          "type": "array",
          "minItems": 1,
          "maxItems": 9,
          "items": {
            "$ref": "#/definitions/RecommenderSchemaField"
          },
          "insertionOrder": false
        }
      },
      "additionalProperties": false
    },
    "CreatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "Status": {
      "type": "string",
      "enum": [
        "ACTIVE",
        "DELETING"
      ]
    },
    "Tags": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "properties": {
          "Key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": ""
          },
          "Value": {
            "type": "string",
            "minLength": 0,
            "maxLength": 256
          }
        },
        "required": [
          "Key",
          "Value"
        ],
        "additionalProperties": false
      },
      "insertionOrder": false
    }
  },
  "required": [
    "DomainName",
    "RecommenderSchemaName",
    "Fields"
  ],
  "additionalProperties": false,
  "readOnlyProperties": [
    "/properties/Arn",
    "/properties/CreatedAt",
    "/properties/Status"
  ],
  "createOnlyProperties": [
    "/properties/DomainName",
    "/properties/RecommenderSchemaName",
    "/properties/Fields"
  ],
  "primaryIdentifier": [
    "/properties/Arn"
  ],
  "additionalIdentifiers": [
    [
      "/properties/DomainName",
      "/properties/RecommenderSchemaName"
    ]
  ],
  "replacementStrategy": "delete_then_create",
  "tagging": {
    "taggable": true,
    "tagOnCreate": true,
    "tagUpdatable": true,
    "cloudFormationSystemTags": false,
    "tagProperty": "/properties/Tags",
    "permissions": [
      "profile:TagResource",
      "profile:UntagResource",
      "profile:ListTagsForResource"
    ]
  },
  "handlers": {
    "create": {
      "permissions": [
        "profile:CreateRecommenderSchema",
        "profile:GetRecommenderSchema",
        "profile:ListTagsForResource",
        "profile:TagResource",
        "kms:GenerateDataKey",
        "kms:Decrypt"
      ]
    },
    "read": {
      "permissions": [
        "profile:GetRecommenderSchema",
        "profile:ListTagsForResource"
      ]
    },
    "update": {
      "permissions": [
        "profile:GetRecommenderSchema",
        "profile:ListTagsForResource",
        "profile:TagResource",
        "profile:UntagResource"
      ]
    },
    "delete": {
      "permissions": [
        "profile:DeleteRecommenderSchema",
        "profile:GetRecommenderSchema"
      ]
    },
    "list": {
      "permissions": [
        "profile:ListRecommenderSchemas"
      ],
      "handlerSchema": {
        "properties": {
          "DomainName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-zA-Z0-9_-]+$"
          }
        },
        "required": [
          "DomainName"
        ]
      }
    }
  }
}
