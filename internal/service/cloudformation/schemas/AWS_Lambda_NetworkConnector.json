        "ec2:DescribeSecurityGroups",
        "ec2:DescribeSubnets"
      ]
    },
    "update": {
      "permissions": [
        "lambda:UpdateNetworkConnector",
        "lambda:GetNetworkConnector",
        "lambda:TagResource",
        "lambda:UntagResource",
        "ec2:DescribeSecurityGroups",
        "ec2:DescribeSubnets",
        "iam:PassRole"
      ]
    },
    "list": {
      "permissions": [
        "lambda:ListNetworkConnectors"
      ],
      "handlerSchema": {
        "properties": {
          "State": {
            "description": "The current state of the network connector.",
            "type": "string",
            "enum": [
              "PENDING",
              "ACTIVE",
              "INACTIVE",
              "FAILED",
              "DELETING",
              "DELETE_FAILED"
            ]
          }
        }
