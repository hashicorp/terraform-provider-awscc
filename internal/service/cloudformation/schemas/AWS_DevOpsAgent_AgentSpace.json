      "maxLength": 1000
    },
    "KmsKeyArn": {
      "description": "The ARN of the KMS key to use for encryption.",
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "Locale": {
      "description": "The locale for the AgentSpace, which determines the language used in agent responses.",
      "type": "string",
      "minLength": 2,
      "maxLength": 35,
      "pattern": "^[a-zA-Z]{2,3}(-[a-zA-Z0-9]{2,8})*$"
    },
