{
  "typeName": "AWS::CodeConnections::Host",
  "description": "A resource that represents the infrastructure where a third-party provider is installed. You create one host for all connections to that provider.",
  "definitions": {
    "Tag": {
      "type": "object",
      "properties": {
        "Key": {
          "type": "string",
          "description": "The tag's key.",
          "minLength": 1,
          "maxLength": 128
        },
        "Value": {
          "type": "string",
          "description": "The tag's value.",
          "minLength": 0,
          "maxLength": 256
        }
      },
      "required": [
        "Key",
        "Value"
      ],
      "additionalProperties": false
    },
    "VpcConfiguration": {
      "type": "object",
      "description": "The VPC configuration provisioned for the host.",
      "properties": {
        "VpcId": {
          "type": "string",
          "description": "The ID of the Amazon VPC connected to the infrastructure where your provider type is installed.",
          "minLength": 12,
          "maxLength": 21,
          "pattern": "^vpc-\\w{8}(\\w{9})?$"
        },
        "SubnetIds": {
          "type": "array",
          "description": "The ID of the subnet or subnets associated with the Amazon VPC.",
          "items": {
            "type": "string",
            "minLength": 15,
            "maxLength": 24,
            "pattern": "^subnet-\\w{8}(\\w{9})?$"
          },
          "minItems": 1,
          "maxItems": 10,
          "insertionOrder": false
        },
        "SecurityGroupIds": {
          "type": "array",
          "description": "The ID of the security group or security groups associated with the Amazon VPC.",
          "items": {
            "type": "string",
            "minLength": 11,
            "maxLength": 20,
            "pattern": "^sg-\\w{8}(\\w{9})?$"
          },
          "minItems": 1,
          "maxItems": 10,
          "insertionOrder": false
        },
        "TlsCertificate": {
          "type": "string",
          "description": "The value of the Transport Layer Security (TLS) certificate associated with the infrastructure where your provider type is installed.",
          "minLength": 1,
          "maxLength": 16384
        }
      },
      "required": [
        "VpcId",
        "SubnetIds",
        "SecurityGroupIds"
      ],
      "additionalProperties": false
    }
  },
  "properties": {
    "HostArn": {
      "type": "string",
      "description": "The Amazon Resource Name (ARN) of the host.",
      "minLength": 0,
      "maxLength": 256,
      "pattern": "^arn:aws(-[\\w]+)*:(codestar-connections|codeconnections):.+:[0-9]{12}:host\\/.+$"
    },
    "HostId": {
      "type": "string",
      "description": "The server-generated unique identifier for the host."
    },
    "Name": {
      "type": "string",
      "description": "The name of the host.",
      "minLength": 1,
      "maxLength": 64
    },
    "ProviderType": {
      "type": "string",
      "description": "The name of the installed provider to be associated with your connection.",
      "enum": [
        "Bitbucket",
        "GitHub",
        "GitHubEnterpriseServer",
        "GitLab",
        "GitLabSelfManaged",
        "AzureDevOps"
      ]
    },
    "ProviderEndpoint": {
      "type": "string",
      "description": "The endpoint of the infrastructure where your provider type is installed.",
      "minLength": 1,
      "maxLength": 512
    },
    "VpcConfiguration": {
      "$ref": "#/definitions/VpcConfiguration"
    },
    "Status": {
      "type": "string",
      "description": "The status of the host.",
      "minLength": 1,
      "maxLength": 64
    },
    "Tags": {
      "type": "array",
      "description": "Tags to apply to the host.",
      "items": {
        "$ref": "#/definitions/Tag"
      },
      "insertionOrder": false,
      "uniqueItems": true
    }
  },
  "required": [
    "Name",
    "ProviderType",
    "ProviderEndpoint"
  ],
  "additionalProperties": false,
  "readOnlyProperties": [
    "/properties/HostArn",
    "/properties/HostId",
    "/properties/Status"
  ],
  "createOnlyProperties": [
    "/properties/Name",
    "/properties/ProviderType"
  ],
  "primaryIdentifier": [
    "/properties/HostArn"
  ],
  "additionalIdentifiers": [
    [
      "/properties/HostId"
    ]
  ],
  "tagging": {
    "taggable": true,
    "tagOnCreate": true,
    "tagUpdatable": true,
    "cloudFormationSystemTags": true,
    "tagProperty": "/properties/Tags",
    "permissions": [
      "codeconnections:TagResource",
      "codeconnections:UntagResource",
      "codeconnections:ListTagsForResource"
    ]
  },
  "handlers": {
    "create": {
      "permissions": [
        "codeconnections:CreateHost",
        "codeconnections:GetHost",
        "codeconnections:TagResource",
        "ec2:CreateNetworkInterface",
        "ec2:CreateTags",
        "ec2:CreateVpcEndpoint",
        "ec2:DeleteNetworkInterface",
        "ec2:DeleteVpcEndpoints",
        "ec2:DescribeDhcpOptions",
        "ec2:DescribeNetworkInterfaces",
        "ec2:DescribeSecurityGroups",
        "ec2:DescribeSubnets",
        "ec2:DescribeVpcEndpoints",
        "ec2:DescribeVpcs"
      ]
    },
    "read": {
      "permissions": [
        "codeconnections:GetHost",
        "codeconnections:ListTagsForResource"
      ]
    },
    "update": {
      "permissions": [
        "codeconnections:GetHost",
        "codeconnections:UpdateHost",
        "codeconnections:TagResource",
        "codeconnections:UntagResource",
        "codeconnections:ListTagsForResource",
        "ec2:CreateNetworkInterface",
        "ec2:CreateTags",
        "ec2:CreateVpcEndpoint",
        "ec2:DeleteNetworkInterface",
        "ec2:DeleteVpcEndpoints",
        "ec2:DescribeDhcpOptions",
        "ec2:DescribeNetworkInterfaces",
        "ec2:DescribeSecurityGroups",
        "ec2:DescribeSubnets",
        "ec2:DescribeVpcEndpoints",
        "ec2:DescribeVpcs",
        "ec2:ModifyVpcEndpoint"
      ]
    },
    "delete": {
      "permissions": [
        "codeconnections:DeleteHost",
        "codeconnections:GetHost",
        "ec2:DeleteNetworkInterface",
        "ec2:DeleteVpcEndpoints",
        "ec2:DescribeNetworkInterfaces",
        "ec2:DescribeVpcEndpoints"
      ]
    },
    "list": {
      "permissions": [
        "codeconnections:ListHosts"
      ]
    }
  }
}
