{
  "typeName": "AWS::BedrockAgentCore::PaymentManager",
  "description": "Resource Type definition for AWS::BedrockAgentCore::PaymentManager",
  "properties": {
    "Name": {
      "type": "string",
      "description": "The name of the payment manager",
      "pattern": "^[a-zA-Z][a-zA-Z0-9]{0,47}$",
      "minLength": 1,
      "maxLength": 48
    },
    "Description": {
      "type": "string",
      "description": "A description of the payment manager",
      "pattern": "^[^\\p{C}]*$",
      "minLength": 1,
      "maxLength": 4096
    },
    "AuthorizerType": {
      "type": "string",
      "description": "The type of authorizer for the payment manager",
      "enum": [
        "CUSTOM_JWT",
        "AWS_IAM"
      ]
    },
    "AuthorizerConfiguration": {
      "$ref": "#/definitions/AuthorizerConfiguration",
      "description": "The authorizer configuration for the payment manager"
    },
    "RoleArn": {
      "type": "string",
      "description": "The ARN of the IAM role for the payment manager",
      "pattern": "^arn:aws(-[^:]+)?:iam::([0-9]{12})?:role/.+$",
      "minLength": 1,
      "maxLength": 2048
    },
    "PaymentManagerId": {
      "type": "string",
      "description": "The unique identifier for the payment manager",
      "pattern": "^([0-9a-z][-]?){1,100}-[0-9a-z]{10}$",
      "minLength": 12,
      "maxLength": 211
    },
    "WorkloadIdentityDetails": {
      "$ref": "#/definitions/WorkloadIdentityDetails",
      "description": "The workload identity details for the payment manager"
    },
    "CreatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "The timestamp when the payment manager was created"
    },
    "Status": {
      "type": "string",
      "description": "The current status of the payment manager",
      "enum": [
        "CREATING",
        "UPDATING",
        "DELETING",
        "READY",
        "CREATE_FAILED",
        "UPDATE_FAILED",
        "DELETE_FAILED"
      ]
    },
    "LastUpdatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "The timestamp when the payment manager was last updated"
    },
    "PaymentManagerArn": {
      "type": "string",
      "description": "The Amazon Resource Name (ARN) of the resource.",
      "pattern": "^arn:aws(?:-[a-z]+)*:bedrock-agentcore:(?:[a-z]{2,4}(?:-[a-z0-9]+)+)?:[0-9]{12}:payment-manager/(?:([0-9a-z][-]?){1,100}-[0-9a-z]{10})$"
    },
    "Tags": {
      "type": "array",
      "uniqueItems": true,
      "insertionOrder": false,
      "description": "An array of key-value pairs to apply to this resource.",
      "items": {
        "$ref": "#/definitions/Tag"
      },
      "maxItems": 50
    }
  },
  "definitions": {
    "ClaimMatchValue": {
      "oneOf": [
        {
          "type": "object",
          "title": "MatchValueString",
          "properties": {
            "MatchValueString": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.:/-]+$",
              "minLength": 1,
              "maxLength": 255
            }
          },
          "required": [
            "MatchValueString"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "title": "MatchValueStringList",
          "properties": {
            "MatchValueStringList": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.:/-]+$",
                "minLength": 1,
                "maxLength": 255
              },
              "minItems": 1,
              "insertionOrder": false
            }
          },
          "required": [
            "MatchValueStringList"
          ],
          "additionalProperties": false
        }
