        "ClaimMatchValue",
        "ClaimMatchOperator"
      ],
      "additionalProperties": false
    },
    "CustomClaimValidationType": {
      "type": "object",
      "properties": {
        "InboundTokenClaimName": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-:]+$",
          "minLength": 1,
          "maxLength": 255
        },
