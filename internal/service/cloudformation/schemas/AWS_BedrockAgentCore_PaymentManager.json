            "type": "string"
          },
          "minItems": 1,
          "insertionOrder": false
        },
        "AllowedClients": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "insertionOrder": false
        },
        "AllowedScopes": {
          "type": "array",
