{
  "typeName": "AWS::IVS::AdConfiguration",
  "description": "Resource type definition for AWS::IVS::AdConfiguration. An ad configuration links Amazon IVS resources to AWS Elemental MediaTailor playback configurations, enabling server-side ad insertion for a channel.",
  "definitions": {
    "MediaTailorPlaybackConfiguration": {
      "description": "Object specifying a configuration for integration with an AWS Elemental MediaTailor (EMT).",
      "type": "object",
      "properties": {
        "PlaybackConfigurationArn": {
          "description": "ARN of the customer-created EMT PlaybackConfiguration resource in the same region and account.",
          "type": "string",
          "minLength": 0,
          "maxLength": 128,
          "pattern": "^arn:aws:mediatailor:[a-z0-9-]+:[0-9]+:playbackConfiguration/[a-zA-Z0-9-]+$"
        }
      },
      "additionalProperties": false
    },
    "PostRollConfiguration": {
      "description": "Configuration for the post-roll ad break to use for this ad configuration.",
      "type": "object",
      "properties": {
        "DurationSeconds": {
          "description": "Duration of the post-roll ad break, in seconds.",
          "type": "integer",
          "minimum": 1,
          "maximum": 300
        },
        "Enabled": {
          "description": "Whether the post-roll ad configuration is enabled.",
          "type": "boolean"
        }
      },
      "required": [
        "DurationSeconds",
        "Enabled"
      ],
      "additionalProperties": false
    },
    "Tag": {
      "description": "A key-value pair to associate with a resource.",
      "type": "object",
      "properties": {
        "Key": {
          "description": "The key name of the tag.",
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^([\\p{L}\\p{Z}\\p{N}_.:/=+\\-@]+)$"
        },
        "Value": {
          "description": "The value for the tag.",
          "type": "string",
          "minLength": 0,
          "maxLength": 256,
          "pattern": "^([\\p{L}\\p{Z}\\p{N}_.:/=+\\-@]*)$"
        }
      },
      "required": [
        "Key",
        "Value"
      ],
      "additionalProperties": false
    }
  },
  "properties": {
    "Arn": {
      "description": "Ad configuration ARN.",
      "type": "string",
      "minLength": 0,
      "maxLength": 128,
      "pattern": "^arn:aws:ivs:[a-z0-9-]+:[0-9]+:ad-configuration/[a-zA-Z0-9-]+$"
    },
    "Name": {
      "description": "Ad configuration name. The value does not need to be unique.",
      "type": "string",
      "minLength": 0,
      "maxLength": 128,
      "pattern": "^[a-zA-Z0-9-_]*$"
    },
    "MediaTailorPlaybackConfigurations": {
      "description": "List of integration configurations with MediaTailor resources. The first item in the list is the default playback configuration used for the ad configuration.",
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "$ref": "#/definitions/MediaTailorPlaybackConfiguration"
      }
    },
    "PostRollConfiguration": {
      "$ref": "#/definitions/PostRollConfiguration"
    },
    "Tags": {
      "description": "Tags attached to the resource.",
      "type": "array",
      "maxItems": 50,
      "uniqueItems": true,
      "insertionOrder": false,
      "items": {
        "$ref": "#/definitions/Tag"
      }
    }
  },
  "required": [
    "MediaTailorPlaybackConfigurations"
  ],
  "additionalProperties": false,
  "readOnlyProperties": [
    "/properties/Arn"
  ],
  "primaryIdentifier": [
    "/properties/Arn"
  ],
  "tagging": {
    "taggable": true,
    "tagOnCreate": true,
    "tagUpdatable": true,
    "cloudFormationSystemTags": true,
    "tagProperty": "/properties/Tags",
    "permissions": [
      "ivs:TagResource",
      "ivs:UntagResource",
      "ivs:ListTagsForResource"
    ]
  },
  "handlers": {
    "create": {
      "permissions": [
        "ivs:CreateAdConfiguration",
        "ivs:TagResource",
        "mediatailor:GetPlaybackConfiguration"
      ]
    },
    "read": {
      "permissions": [
        "ivs:GetAdConfiguration",
        "ivs:ListTagsForResource"
      ]
    },
    "update": {
      "permissions": [
        "ivs:UpdateAdConfiguration",
        "ivs:TagResource",
        "ivs:UntagResource",
        "ivs:ListTagsForResource",
        "mediatailor:GetPlaybackConfiguration"
      ]
    },
    "delete": {
      "permissions": [
        "ivs:DeleteAdConfiguration"
      ]
    },
    "list": {
      "permissions": [
        "ivs:ListAdConfigurations"
      ]
    }
  }
}
