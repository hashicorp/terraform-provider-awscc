{
  "typeName": "AWS::ServiceDiscovery::PrivateDnsNamespace",
  "description": "Resource Type definition for AWS::ServiceDiscovery::PrivateDnsNamespace",
  "additionalProperties": false,
  "properties": {
    "Description": {
      "type": "string",
      "description": "A description of the namespace.",
      "maxLength": 1024
    },
    "HostedZoneId": {
      "type": "string",
      "description": "The ID for the Route 53 hosted zone that AWS Cloud Map creates when you create a namespace."
    },
    "Vpc": {
      "type": "string",
      "description": "The ID of the Amazon VPC that you want to associate the namespace with."
    },
    "Id": {
      "type": "string",
      "description": "The ID of the private namespace."
    },
    "Arn": {
      "type": "string",
      "description": "The Amazon Resource Name (ARN) of the private namespace.",
      "pattern": "^arn:aws[-a-z]*:servicediscovery:[a-z0-9-]+:[0-9]{12}:namespace/ns-[a-z0-9]{16}$"
    },
    "Properties": {
      "$ref": "#/definitions/Properties",
      "description": "Properties of the private DNS namespace."
    },
    "Tags": {
      "type": "array",
      "description": "The tags for the namespace. Each tag consists of a key and an optional value, both of which you define. Tag keys can have a maximum character length of 128 characters, and tag values can have a maximum length of 256 characters.",
      "uniqueItems": false,
      "insertionOrder": false,
      "items": {
        "$ref": "#/definitions/Tag"
      }
    },
    "Name": {
      "type": "string",
      "description": "The name that you want to assign to this namespace. When you create a private DNS namespace, AWS Cloud Map automatically creates an Amazon Route 53 private hosted zone that has the same name as the namespace.",
      "minLength": 1,
      "maxLength": 1024
    }
  },
  "definitions": {
    "PrivateDnsPropertiesMutable": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "SOA": {
          "$ref": "#/definitions/SOA"
        }
      }
    },
    "SOA": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "TTL": {
          "type": "number",
          "minimum": 0,
          "maximum": 2147483647
        }
      }
    },
    "Tag": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "Value": {
          "type": "string"
        },
        "Key": {
          "type": "string"
        }
      },
      "required": [
        "Value",
        "Key"
      ]
    },
    "Properties": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "DnsProperties": {
          "$ref": "#/definitions/PrivateDnsPropertiesMutable"
        }
      }
    }
  },
  "required": [
    "Name"
  ],
  "createOnlyProperties": [
    "/properties/Vpc",
    "/properties/Name"
  ],
  "writeOnlyProperties": [
    "/properties/Vpc"
  ],
  "primaryIdentifier": [
    "/properties/Id"
  ],
  "readOnlyProperties": [
    "/properties/Id",
    "/properties/HostedZoneId",
    "/properties/Arn"
  ],
  "tagging": {
    "taggable": true,
    "tagOnCreate": true,
    "tagUpdatable": true,
    "cloudFormationSystemTags": true,
    "tagProperty": "/properties/Tags",
    "permissions": [
      "servicediscovery:TagResource",
      "servicediscovery:UntagResource",
      "servicediscovery:ListTagsForResource"
    ]
  },
  "handlers": {
    "create": {
      "permissions": [
        "servicediscovery:CreatePrivateDnsNamespace",
        "servicediscovery:TagResource",
        "servicediscovery:GetOperation",
        "servicediscovery:GetNamespace",
        "servicediscovery:ListTagsForResource",
        "route53:CreateHostedZone",
        "route53:GetHostedZone",
        "route53:ListHostedZonesByName",
        "ec2:DescribeVpcs",
        "ec2:DescribeRegions"
      ]
    },
    "read": {
      "permissions": [
        "servicediscovery:GetNamespace",
        "servicediscovery:ListTagsForResource"
      ]
    },
    "update": {
      "permissions": [
        "servicediscovery:UpdatePrivateDnsNamespace",
        "servicediscovery:UntagResource",
        "servicediscovery:TagResource",
        "servicediscovery:GetOperation",
        "servicediscovery:GetNamespace",
        "servicediscovery:ListTagsForResource",
        "route53:ChangeResourceRecordSets"
      ]
    },
    "delete": {
      "permissions": [
        "servicediscovery:DeleteNamespace",
        "servicediscovery:GetOperation"
      ]
    },
    "list": {
      "permissions": [
        "servicediscovery:ListNamespaces"
      ]
    }
  }
}
